---
import Layout from '../layouts/Layout.astro';
import { getSession } from 'auth-astro/server';

// Check if user is already logged in
const session = await getSession(Astro.request);
if (session) {
  return Astro.redirect('/admin');
}

// Get error from URL params
const error = Astro.url.searchParams.get('error');
---

<Layout title="Iniciar Sesión | Mister LyA">
  <div class="min-h-screen flex items-center justify-center bg-surface px-4">
    <div class="w-full max-w-md">
      <!-- Logo and Branding -->
      <div class="text-center mb-8 flex flex-col items-center">
        <a href="/" class="transition-transform hover:scale-105 duration-300">
          <img src="/logo-h.png" alt="Mister LyA" class="h-28 md:h-36 w-auto mb-6 drop-shadow-sm" />
        </a>
        <h1 class="text-display-small font-display font-bold text-on-surface mb-2 sr-only">
          Mister LyA
        </h1>
      </div>

      <!-- Login Card -->
      <div class="bg-surface-container rounded-3xl shadow-md p-8">
        <h2 class="text-headline-medium font-display font-semibold text-on-surface mb-2">
          Iniciar Sesión
        </h2>
        <p class="text-body-medium text-on-surface-variant mb-6">
          Accede al panel de administración
        </p>

        <!-- Error Message -->
        {error && (
          <div class="mb-6 p-4 bg-error-container rounded-xl flex items-start gap-3">
            <span class="material-symbols-outlined text-on-error-container flex-shrink-0">
              error
            </span>
            <div>
              <p class="text-label-large font-semibold text-on-error-container mb-1">
                Error de autenticación
              </p>
              <p class="text-body-small text-on-error-container">
                Credenciales inválidas. Por favor, verifica tu email y contraseña.
              </p>
            </div>
          </div>
        )}

        <!-- Login Form -->
        <form id="login-form" class="space-y-6">
          <!-- Email Field -->
          <div>
            <label for="email" class="block text-label-large font-medium text-on-surface mb-2">
              Email
            </label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant">
                mail
              </span>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="w-full pl-14 pr-4 py-3.5 bg-surface-container-high rounded-xl border border-outline text-body-large text-on-surface placeholder:text-on-surface-variant focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                placeholder="admin@misterlya.com"
              />
            </div>
          </div>

          <!-- Password Field -->
          <div>
            <label for="password" class="block text-label-large font-medium text-on-surface mb-2">
              Contraseña
            </label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant">
                lock
              </span>
              <input
                type="password"
                id="password"
                name="password"
                required
                autocomplete="current-password"
                class="w-full pl-14 pr-4 py-3.5 bg-surface-container-high rounded-xl border border-outline text-body-large text-on-surface placeholder:text-on-surface-variant focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                placeholder="••••••••"
              />
            </div>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3.5 px-6 bg-primary text-on-primary rounded-full text-label-large font-semibold hover:shadow-md hover:brightness-105 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="submit-text">Iniciar Sesión</span>
            <span class="material-symbols-outlined" id="submit-icon">
              arrow_forward
            </span>
          </button>
        </form>
      </div>

      <!-- Footer -->
      <p class="text-center text-body-small text-on-surface-variant mt-6">
        &copy; 2026 Mister LyA. Todos los derechos reservados.
      </p>
    </div>
  </div>
</Layout>

<script>
  const { signIn } = await import("auth-astro/client");

  const form = document.getElementById("login-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const submitText = document.getElementById("submit-text") as HTMLSpanElement;
  const submitIcon = document.getElementById("submit-icon") as HTMLSpanElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    
    if (submitBtn) submitBtn.disabled = true;
    if (submitText) submitText.textContent = "Verificando...";
    if (submitIcon) submitIcon.textContent = "hourglass_empty";

    const formData = new FormData(e.target as HTMLFormElement);
    const data = Object.fromEntries(formData);
    
    // Call NextAuth / Auth.js sign in method
    await signIn("credentials", { 
      email: data.email, 
      password: data.password, 
      callbackUrl: "/admin" 
    });
  });
</script>

<style>
  /* Material Symbols icon styling */
  .material-symbols-outlined {
    font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24;
  }
</style>
