---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (accessToken) {
  const { data, error } = await supabase.auth.getUser(accessToken);
  if (!error && data?.user) {
    return Astro.redirect('/admin');
  }
}

const error = Astro.url.searchParams.get('error');
---

<Layout title="Iniciar sesion | Casa de Fiestas">
  <div class="relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-16">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(166,128,83,0.18),transparent_24%),radial-gradient(circle_at_bottom_right,rgba(130,140,108,0.18),transparent_28%)]"></div>

    <div class="relative z-10 w-full max-w-md">
      <div class="mb-8 text-center">
        <a href="/" class="inline-flex transition-transform duration-300 hover:scale-105">
          <img src="/logo-circle.webp" alt="Casa de Fiestas" class="h-28 w-28 md:h-36 md:w-36 rounded-full object-cover shadow-[0_10px_30px_rgba(115,59,10,0.18)] border border-secondary/15" />
        </a>
      </div>

      <div class="luxury-panel ambient-border rounded-[2rem] p-8 shadow-[0_30px_80px_rgba(71,54,33,0.1)]">
        <span class="section-kicker mb-3 inline-block text-[11px] font-bold">Panel privado</span>
        <h1 class="font-headline text-4xl font-bold text-tertiary">Iniciar sesion</h1>
        <p class="mt-2 text-sm leading-6 text-on-surface-variant">Accede al panel administrativo con la nueva identidad visual de la marca.</p>

        {error && (
          <div class="mt-6 flex items-start gap-3 rounded-[1.25rem] bg-error-container px-4 py-4">
            <span class="material-symbols-outlined flex-shrink-0 text-on-error-container">error</span>
            <div>
              <p class="font-semibold text-on-error-container">No pudimos validar el acceso.</p>
              <p class="mt-1 text-sm text-on-error-container">Verifica tus credenciales e intenta de nuevo.</p>
            </div>
          </div>
        )}

        <form id="login-form" class="mt-6 space-y-5">
          <div>
            <label for="email" class="mb-2 block text-sm font-semibold text-tertiary">Email</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant">mail</span>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="w-full rounded-[1.25rem] border border-outline-variant bg-surface-container-low py-3.5 pl-14 pr-4 text-on-surface transition-all focus:outline-none focus:ring-2 focus:ring-secondary"
                placeholder="admin@casadefiestas.com"
              />
            </div>
          </div>

          <div>
            <label for="password" class="mb-2 block text-sm font-semibold text-tertiary">Contrasena</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant">lock</span>
              <input
                type="password"
                id="password"
                name="password"
                required
                autocomplete="current-password"
                class="w-full rounded-[1.25rem] border border-outline-variant bg-surface-container-low py-3.5 pl-14 pr-4 text-on-surface transition-all focus:outline-none focus:ring-2 focus:ring-secondary"
                placeholder="********"
              />
            </div>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-secondary px-6 py-3.5 text-sm font-bold uppercase tracking-[0.16em] text-on-secondary transition-all hover:-translate-y-0.5 hover:shadow-[0_18px_40px_rgba(115,59,10,0.2)] disabled:cursor-not-allowed disabled:opacity-60"
          >
            <span id="submit-text">Ingresar</span>
            <span class="material-symbols-outlined" id="submit-icon">arrow_forward</span>
          </button>
        </form>
      </div>

      <p class="mt-6 text-center text-xs text-on-surface-variant">
        © 2026 Casa de Fiestas | Sempertex & Detalles. Todos los derechos reservados.
      </p>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('login-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const submitText = document.getElementById('submit-text') as HTMLSpanElement;
  const submitIcon = document.getElementById('submit-icon') as HTMLSpanElement;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (submitBtn) submitBtn.disabled = true;
    if (submitText) submitText.textContent = 'Validando';
    if (submitIcon) submitIcon.textContent = 'hourglass_empty';

    const formData = new FormData(event.target as HTMLFormElement);
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password
      });

      if (error) {
        throw error;
      }

      if (data?.session) {
        const session = data.session;
        // Set cookies with max-age matching the session expires_in (omitting Secure on localhost HTTP)
        const isSecure = window.location.protocol === 'https:' ? '; Secure' : '';
        document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=${session.expires_in}; SameSite=Lax${isSecure}`;
        document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=${session.expires_in}; SameSite=Lax${isSecure}`;
        
        // Redirect to admin panel
        window.location.href = '/admin';
      } else {
        throw new Error('No se pudo establecer la sesión');
      }
    } catch (err: any) {
      console.error('Error de login:', err);
      // Redirect to login page showing error parameter
      window.location.href = '/login?error=true';
    }
  });
</script>
