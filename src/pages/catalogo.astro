---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import InteractiveCatalog from '../components/InteractiveCatalog.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { supabaseAdmin } from '../lib/supabase';

// Fetch products and categories from database
let products: any[] = [];
let categories: any[] = [];
let fetchError = false;

try {
	const parseJsonField = (value: unknown, fallback: any) => {
		if (value == null) return fallback;
		if (typeof value === 'string') {
			try {
				return JSON.parse(value);
			} catch {
				return fallback;
			}
		}
		return value;
	};

	const [productsRes, categoriesRes] = await Promise.all([
		supabaseAdmin.from('products').select('*'),
		supabaseAdmin.from('categories').select('*').order('order', { ascending: true })
	]);

	if (productsRes.error) throw productsRes.error;
	if (categoriesRes.error) throw categoriesRes.error;

	// Parse JSON fields and filter only active products
	products = (productsRes.data || [])
		.filter((p: any) => p.active === true)
		.map((p: any) => ({
			...p,
			categoryId: p.category_id, // Map database snake_case to JavaScript camelCase
			variants: parseJsonField(p.variants, null),
			images: parseJsonField(p.images, []),
		}));

	categories = categoriesRes.data || [];
} catch (error) {
	console.error('Error fetching data from database:', error);
	fetchError = true;
}
---

<Layout 
	title="Catálogo | Casa de Fiestas"
	description="Explora globos Sempertex, arreglos para fiestas, combos por ocasion y accesorios especiales en nuestro catalogo."
>
	<Navbar />
	
	<main class="pt-14">
		{fetchError ? (
			<div class="min-h-screen flex items-center justify-center bg-surface-container-low">
				<div class="text-center p-8 max-w-md">
					<span class="material-symbols-outlined text-6xl text-on-surface-variant mb-4">error</span>
					<h2 class="font-headline text-2xl font-bold text-primary mb-4">
						No pudimos cargar el catálogo
					</h2>
					<p class="text-on-surface-variant mb-6">
						Por favor, intenta recargar la página o contáctanos por WhatsApp.
					</p>
					<button 
						class="bg-primary text-on-primary px-6 py-3 rounded-full font-bold hover:scale-95 transition-all"
						onclick="window.location.reload()"
					>
						Recargar página
					</button>
				</div>
			</div>
		) : (
			<InteractiveCatalog products={products} categories={categories} />
		)}
	</main>
	
	<Footer />
	<WhatsAppButton position="left" />
</Layout>
