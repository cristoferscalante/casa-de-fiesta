---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { getQuoteBySlug } from '../../data/quotes';

const clientSlug = Astro.params.cliente ?? '';
const quote = getQuoteBySlug(clientSlug);

if (!quote) {
	Astro.response.status = 404;
}

const currency = new Intl.NumberFormat('es-CO', {
	style: 'currency',
	currency: 'COP',
	maximumFractionDigits: 0,
});

const updatedFormatter = new Intl.DateTimeFormat('es-CO', {
	dateStyle: 'medium',
	timeStyle: 'short',
});

const eventDateFormatter = new Intl.DateTimeFormat('es-CO', {
	dateStyle: 'long',
});

const hasImages = (quote?.images?.length ?? 0) > 0;
---

<Layout
	title={`Cotizacion para ${quote?.clientName ?? 'cliente'} | Casa de Fiestas`}
	description={`Cotizacion personalizada para ${quote?.clientName ?? 'cliente'} con Casa de Fiestas.`}
	robots="noindex, nofollow"
>
	<Navbar />

	<main class="relative z-10 px-4 pb-12 pt-28 md:px-8 lg:px-12">
		{quote ? (
			<section class="mx-auto max-w-screen-2xl">
				<div class="luxury-panel ambient-border rounded-[2rem] px-6 py-8 md:px-10 md:py-10">
					<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
						<div>
							<p class="section-kicker text-[11px] font-bold">Cotizacion personalizada</p>
							<h1 class="mt-4 font-headline text-4xl font-bold text-tertiary md:text-6xl">
								{quote.clientName}
							</h1>
							<p class="mt-4 max-w-3xl text-sm leading-7 text-on-surface-variant md:text-base">
								{quote.summary}
							</p>
						</div>

						<div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4 lg:min-w-[420px]">
							<div class="rounded-[1.5rem] bg-white/75 px-4 py-4 shadow-[0_16px_40px_rgba(71,54,33,0.06)]">
								<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-secondary">Estado</p>
								<p class="mt-2 font-semibold text-on-surface">{quote.status}</p>
							</div>
							<div class="rounded-[1.5rem] bg-white/75 px-4 py-4 shadow-[0_16px_40px_rgba(71,54,33,0.06)]">
								<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-secondary">Evento</p>
								<p class="mt-2 font-semibold text-on-surface">{eventDateFormatter.format(new Date(quote.eventDate))}</p>
							</div>
							<div class="rounded-[1.5rem] bg-white/75 px-4 py-4 shadow-[0_16px_40px_rgba(71,54,33,0.06)]">
								<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-secondary">Actualizada</p>
								<p class="mt-2 font-semibold text-on-surface">{updatedFormatter.format(new Date(quote.updatedAt))}</p>
							</div>
							<div class="rounded-[1.5rem] bg-white/75 px-4 py-4 shadow-[0_16px_40px_rgba(71,54,33,0.06)]">
								<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-secondary">Lugar</p>
								<p class="mt-2 font-semibold text-on-surface">{quote.location ?? 'Por confirmar'}</p>
							</div>
						</div>
					</div>
				</div>

				<div class="mt-8 grid gap-6 xl:grid-cols-[1.25fr_0.75fr]">
					<div class="space-y-6">
						<div class="luxury-panel rounded-[2rem] p-6 md:p-7">
							<div class="flex items-center justify-between gap-4 border-b border-outline-variant/70 pb-4">
								<h2 class="font-headline text-3xl font-semibold text-tertiary">Datos del cliente</h2>
								<p class="text-xs font-bold uppercase tracking-[0.22em] text-secondary">Resumen</p>
							</div>

							<div class="mt-5 grid gap-4 sm:grid-cols-2">
								<div class="rounded-[1.5rem] bg-surface-container-low px-4 py-4">
									<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-secondary">Nombre</p>
									<p class="mt-2 font-semibold text-on-surface">{quote.clientName}</p>
								</div>
								<div class="rounded-[1.5rem] bg-surface-container-low px-4 py-4">
									<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-secondary">Telefono</p>
									<p class="mt-2 font-semibold text-on-surface">{quote.clientPhone ?? 'Por confirmar'}</p>
								</div>
								<div class="rounded-[1.5rem] bg-surface-container-low px-4 py-4">
									<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-secondary">Hora del evento</p>
									<p class="mt-2 font-semibold text-on-surface">{quote.eventTime ?? 'Por confirmar'}</p>
								</div>
								<div class="rounded-[1.5rem] bg-surface-container-low px-4 py-4">
									<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-secondary">Invitados</p>
									<p class="mt-2 font-semibold text-on-surface">{quote.guests ?? 'Por confirmar'}</p>
								</div>
								<div class="rounded-[1.5rem] bg-surface-container-low px-4 py-4 sm:col-span-2">
									<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-secondary">Tematica</p>
									<p class="mt-2 font-semibold text-on-surface">{quote.theme ?? quote.eventType}</p>
								</div>
							</div>
						</div>

						<div class="luxury-panel rounded-[2rem] p-6 md:p-7">
							<div class="flex items-center justify-between gap-4 border-b border-outline-variant/70 pb-4">
								<h2 class="font-headline text-3xl font-semibold text-tertiary">Resumen de inversion</h2>
								<p class="text-xs font-bold uppercase tracking-[0.22em] text-secondary">Detalle</p>
							</div>

							<div class="mt-5 space-y-4">
								{quote.items.map((item) => (
									<div class="rounded-[1.5rem] border border-outline-variant/60 bg-surface-container-low px-4 py-4">
										<div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
											<div>
												<h3 class="text-lg font-bold text-on-surface">{item.concept}</h3>
												<p class="mt-1 text-sm leading-6 text-on-surface-variant">{item.detail}</p>
											</div>
											<p class="shrink-0 rounded-full bg-secondary/10 px-4 py-2 text-sm font-bold text-secondary">
												{item.value === null ? 'Por definir' : currency.format(item.value)}
											</p>
										</div>
									</div>
								))}
							</div>

							<div class="mt-6 rounded-[1.5rem] bg-tertiary px-5 py-5 text-on-tertiary shadow-[0_18px_48px_rgba(115,59,10,0.22)]">
								<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-secondary-fixed">Total estimado</p>
								<p class="mt-2 font-headline text-4xl font-bold text-white">
									{quote.total === null ? 'Por definir' : currency.format(quote.total)}
								</p>
							</div>
						</div>

						<div class="luxury-panel rounded-[2rem] p-6 md:p-7">
							<h2 class="font-headline text-3xl font-semibold text-tertiary">Condiciones</h2>
							<div class="mt-4 grid gap-3 text-sm leading-7 text-on-surface-variant">
								{quote.conditions.map((condition) => (
									<p>{condition}</p>
								))}
							</div>
						</div>

						<div class="luxury-panel rounded-[2rem] p-6 md:p-7">
							<div class="flex items-center justify-between gap-4 border-b border-outline-variant/70 pb-4">
								<h2 class="font-headline text-3xl font-semibold text-tertiary">Referencias visuales</h2>
								<p class="text-xs font-bold uppercase tracking-[0.22em] text-secondary">Imagenes</p>
							</div>

							{hasImages ? (
								<div class="mt-5 grid gap-4 sm:grid-cols-2">
									{quote.images?.map((image) => (
										<figure class="overflow-hidden rounded-[1.5rem] border border-outline-variant/60 bg-surface-container-low">
											<img src={image.src} alt={image.alt} class="h-full w-full object-cover" loading="lazy" />
										</figure>
									))}
								</div>
							) : (
								<p class="mt-5 text-sm leading-7 text-on-surface-variant">
									La estructura para las imagenes ya esta lista. Solo falta agregar los archivos de referencia en `public/` y enlazarlos en esta cotizacion.
								</p>
							)}
						</div>
					</div>

					<aside class="space-y-6">
						<div class="luxury-panel rounded-[2rem] p-6 md:p-7">
							<p class="text-xs font-bold uppercase tracking-[0.22em] text-secondary">Incluye</p>
							<ul class="mt-4 space-y-3 text-sm leading-6 text-on-surface-variant">
								{quote.includes.map((item) => (
									<li class="flex gap-3">
										<span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-secondary"></span>
										<span>{item}</span>
									</li>
								))}
							</ul>
						</div>

						<div class="rounded-[2rem] bg-[linear-gradient(135deg,var(--color-primary-container),var(--color-tertiary))] px-6 py-7 text-white shadow-[0_20px_55px_rgba(71,54,33,0.18)]">
							<p class="text-xs font-bold uppercase tracking-[0.22em] text-secondary-fixed">Confirmacion</p>
							<h2 class="mt-3 font-headline text-3xl font-semibold">Hablemos de los detalles finales</h2>
							<p class="mt-3 text-sm leading-7 text-white/85">
								Si deseas aprobar la propuesta o ajustar algo, escribenos y continuamos contigo.
							</p>
							<a
								href={`https://wa.me/573152183173?text=${encodeURIComponent(`Hola, soy ${quote.clientName} y quiero revisar mi cotizacion.`)}`}
								target="_blank"
								class="mt-5 inline-flex w-full items-center justify-center rounded-full bg-white px-5 py-3 text-sm font-bold text-tertiary transition-transform hover:scale-[0.99]"
							>
								Continuar por WhatsApp
							</a>
						</div>

						<div class="rounded-[2rem] border border-outline-variant/70 bg-surface-container-low px-5 py-5 text-sm text-on-surface-variant md:px-6">
							<p class="font-semibold text-on-surface">Enlace privado</p>
							<p class="mt-2 leading-6">
								Esta pagina no aparece en la navegacion principal y esta marcada para no ser indexada por buscadores.
							</p>
							<a href="/cotizacion" class="mt-4 inline-flex items-center gap-2 font-semibold text-secondary transition-colors hover:text-tertiary">
								Ver listado general
								<span class="material-symbols-outlined text-base">arrow_forward</span>
							</a>
						</div>
					</aside>
				</div>
			</section>
		) : (
			<section class="mx-auto max-w-3xl">
				<div class="luxury-panel rounded-[2rem] px-6 py-10 text-center md:px-10">
					<p class="section-kicker text-[11px] font-bold">Cotizacion no encontrada</p>
					<h1 class="mt-4 font-headline text-4xl font-bold text-tertiary">No encontramos este enlace</h1>
					<p class="mt-4 text-sm leading-7 text-on-surface-variant md:text-base">
						Verifica el enlace compartido o vuelve al listado general de cotizaciones.
					</p>
					<a href="/cotizacion" class="mt-6 inline-flex rounded-full bg-secondary px-6 py-3 text-sm font-bold text-on-secondary">
						Ir al listado
					</a>
				</div>
			</section>
		)}
	</main>

	<Footer />
	<WhatsAppButton position="right" />
</Layout>
