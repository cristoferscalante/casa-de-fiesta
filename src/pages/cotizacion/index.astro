---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { quotesByRecency } from '../../data/quotes';

const currency = new Intl.NumberFormat('es-CO', {
  style: 'currency',
  currency: 'COP',
  maximumFractionDigits: 0,
});

const dateFormatter = new Intl.DateTimeFormat('es-CO', {
  dateStyle: 'medium',
  timeStyle: 'short',
});

const eventDateFormatter = new Intl.DateTimeFormat('es-CO', {
  dateStyle: 'long',
});
---

<Layout
  title="Cotizaciones | Casa de Fiestas"
  description="Listado privado de cotizaciones personalizadas de Casa de Fiestas."
  robots="noindex, nofollow"
>
  <Navbar />

  <main class="relative z-10 px-4 pb-12 pt-28 md:px-8 lg:px-12">
    <section class="mx-auto max-w-screen-2xl">
      <div class="luxury-panel ambient-border rounded-[2rem] px-6 py-8 md:px-10 md:py-10">
        <p class="section-kicker text-[11px] font-bold">Panel de cotizaciones</p>
        <div class="mt-4 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <h1 class="font-headline text-4xl font-bold text-tertiary md:text-6xl">
              Cotizaciones compartidas por enlace
            </h1>
            <p class="mt-4 max-w-3xl text-sm leading-7 text-on-surface-variant md:text-base">
              Este listado muestra todas las cotizaciones ordenadas por la ultima actualizacion. Cada tarjeta abre su enlace individual en `/cotizacion/nombre-cliente`.
            </p>
          </div>
          <div class="rounded-[1.5rem] border border-secondary/20 bg-white/70 px-5 py-4 text-sm shadow-[0_16px_40px_rgba(71,54,33,0.06)]">
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-secondary">Total</p>
            <p class="mt-2 font-semibold text-on-surface">{quotesByRecency.length} cotizaciones</p>
          </div>
        </div>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        {quotesByRecency.map((quote) => (
          <a
            href={`/cotizacion/${quote.slug}`}
            class="group luxury-panel rounded-[2rem] p-6 transition-transform duration-300 hover:-translate-y-1"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-secondary">{quote.eventType}</p>
                <h2 class="mt-3 font-headline text-3xl font-semibold text-tertiary">
                  {quote.clientName}
                </h2>
              </div>
              <span class="rounded-full bg-secondary/12 px-4 py-2 text-xs font-bold uppercase tracking-[0.14em] text-secondary">
                {quote.status}
              </span>
            </div>

            <p class="mt-4 text-sm leading-7 text-on-surface-variant">{quote.summary}</p>

            <div class="mt-6 grid gap-3 text-sm text-on-surface-variant sm:grid-cols-2">
              <div class="rounded-[1.25rem] bg-surface-container-low px-4 py-4">
                <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-secondary">Evento</p>
                <p class="mt-2 font-semibold text-on-surface">{eventDateFormatter.format(new Date(quote.eventDate))}</p>
              </div>
              <div class="rounded-[1.25rem] bg-surface-container-low px-4 py-4">
                <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-secondary">Actualizada</p>
                <p class="mt-2 font-semibold text-on-surface">{dateFormatter.format(new Date(quote.updatedAt))}</p>
              </div>
            </div>

            <div class="mt-6 flex items-center justify-between gap-4 border-t border-outline-variant/70 pt-5">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-secondary">Valor</p>
                <p class="mt-1 text-lg font-bold text-on-surface">
                  {quote.total === null ? 'Por definir' : currency.format(quote.total)}
                </p>
              </div>
              <span class="inline-flex items-center gap-2 text-sm font-semibold text-tertiary transition-colors group-hover:text-secondary">
                Ver cotizacion
                <span class="material-symbols-outlined text-base">arrow_forward</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton position="right" />
</Layout>
