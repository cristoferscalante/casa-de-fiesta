---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Mission from '../components/Mission.astro';
import FeaturedProducts from '../components/FeaturedProducts.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { supabaseAdmin } from '../lib/supabase';

// Fetch products and categories from database
let products: any[] = [];
let categories: any[] = [];
let fetchError = false;

try {
	const parseJsonField = (value: unknown, fallback: any) => {
		if (value == null) return fallback;
		if (typeof value === 'string') {
			try {
				return JSON.parse(value);
			} catch {
				return fallback;
			}
		}
		return value;
	};

	const [productsRes, categoriesRes] = await Promise.all([
		supabaseAdmin.from('products').select('*'),
		supabaseAdmin.from('categories').select('*').order('order', { ascending: true })
	]);

	if (productsRes.error) throw productsRes.error;
	if (categoriesRes.error) throw categoriesRes.error;

	// Parse variants from JSON string
	products = (productsRes.data || []).map((p: any) => ({
		...p,
		categoryId: p.category_id, // Map database snake_case to JavaScript camelCase
		variants: parseJsonField(p.variants, null),
		images: parseJsonField(p.images, []),
	}));

	categories = categoriesRes.data || [];
} catch (error) {
	console.error('Error fetching data from database:', error);
	fetchError = true;
}
---

<Layout 
	title="Casa de Fiestas | Sempertex & Detalles"
	description="Globos Sempertex de todos los colores, tamanos y estilos, combos decorativos para celebraciones y accesorios para fechas especiales."
>
	<Navbar />
	
	<main class="pt-20">
		<Hero products={products} categories={categories} />
		<Mission />
		<FeaturedProducts products={products} categories={categories} />
		<CTA products={products} />
	</main>
	
	<Footer />
	<WhatsAppButton position="right" />
</Layout>
