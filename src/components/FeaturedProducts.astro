---
import { products as localCatalogProducts } from '../data/catalogCasaDeFiestas';
import { getVariantDisplayLabel, normalizeProductVariants } from '../lib/product-variants';

interface Props {
  products: any[];
  categories: any[];
}

const { products = [], categories = [] } = Astro.props;

const formatPrice = (price: number) => {
  if (!price) return 'Consultar';
  return new Intl.NumberFormat('es-CO', {
    style: 'currency',
    currency: 'COP',
    minimumFractionDigits: 0,
  }).format(price);
};

const parseJsonMaybe = (value: unknown, fallback: any) => {
  if (value == null) return fallback;
  if (typeof value === 'string') {
    try {
      return JSON.parse(value);
    } catch {
      return fallback;
    }
  }
  return value;
};

const normalizedProducts = products.map((product) => ({
  ...product,
  variants: normalizeProductVariants(parseJsonMaybe(product.variants, [])),
}));

const activeProducts = normalizedProducts.filter((product) => product?.active);
const activeCategories = categories
  .filter((category) => activeProducts.some((product) => product.categoryId === category.id))
  .sort((a, b) => {
    const aScore = a.id === 'globos' ? 0 : 1;
    const bScore = b.id === 'globos' ? 0 : 1;
    return aScore - bScore;
  });

const getCategoryProducts = (categoryId: string) =>
  activeProducts
    .filter((product) => product.categoryId === categoryId)
    .sort((a, b) => (a.order || 0) - (b.order || 0));

const getProductImage = (product: any) => {
  if (!product) return '/logo-mark.svg';

  if (typeof product.image === 'string' && product.image.trim().length > 0) {
    return product.image;
  }

  const dbImages = parseJsonMaybe(product.images, []);
  if (Array.isArray(dbImages) && dbImages.length > 0 && typeof dbImages[0] === 'string') {
    return dbImages[0];
  }

  const localBySku = localCatalogProducts.find((item) => item.sku === product.sku);
  if (localBySku?.image) return localBySku.image;

  return '/logo-mark.svg';
};

const getFeatures = (product: any) => {
  if (!product) return [];
  if (Array.isArray(product.variants) && product.variants.length > 0) {
    return product.variants
      .map((variant: any) => getVariantDisplayLabel(variant))
      .filter(Boolean)
      .slice(0, 3);
  }

  return [
    'Ideal para decorar, combinar y vender por ocasion.',
    'Variedad lista para personalizar por color y estilo.',
    'Cotizacion asistida por WhatsApp y catalogo.',
  ];
};

const getShortCategoryName = (name: string) => {
  if (!name) return '';
  const firstWord = name.trim().split(' ')[0] || '';
  return firstWord.toLowerCase();
};

const getPreviewImages = (productList: any[]) =>
  productList
    .slice(0, 3)
    .map((product) => ({
      name: product.name,
      image: getProductImage(product),
    }))
    .filter((item) => item.image);

const sections: Array<any> = [];
const maxSections = 3;

if (activeCategories.length > 0) {
  for (let i = 0; i < maxSections; i++) {
    const cat1 = activeCategories[(i * 2) % activeCategories.length] || null;
    const maybeCat2 = activeCategories[(i * 2 + 1) % activeCategories.length] || null;
    const cat2 = maybeCat2 && maybeCat2.id !== cat1?.id ? maybeCat2 : null;

    const cat1Products = cat1 ? getCategoryProducts(cat1.id) : [];
    const cat2Products = cat2 ? getCategoryProducts(cat2.id) : [];

    if (cat1Products.length > 0 || cat2Products.length > 0) {
      sections.push({
        id: `section-${i + 1}`,
        cat1,
        cat2,
        cat1Products,
        cat2Products,
        previews: getPreviewImages(cat1Products),
      });
    }
  }
}

const isEmpty = sections.length === 0;
---

<section class="relative px-5 py-16 md:px-8 md:py-20 lg:px-12 lg:py-24" id="featured-products">
  <div class="mx-auto mb-10 max-w-screen-2xl">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <span class="section-kicker mb-3 inline-block text-[11px] font-bold">Colecciones destacadas</span>
        <h2 class="font-headline text-4xl font-bold leading-tight text-tertiary md:text-5xl">
          Globos protagonistas, combos listos y productos faciles de cotizar.
        </h2>
        <p class="mt-4 text-base leading-8 text-on-surface-variant">
          La portada ahora prioriza lo que mas rota y mas atrae: globos Sempertex, arreglos para celebraciones y
          complementos para subir el valor de cada pedido.
        </p>
      </div>

      <div class="luxury-panel max-w-md rounded-[1.75rem] px-5 py-4">
        <p class="text-[11px] font-bold uppercase tracking-[0.24em] text-secondary">Prioridad comercial</p>
        <p class="mt-2 text-sm leading-6 text-on-surface-variant">
          Primero globos, despues arreglos por ocasion y luego accesorios para completar la compra.
        </p>
      </div>
    </div>
  </div>

  {isEmpty && (
    <div class="py-20 text-center text-on-surface-variant">
      <h2 class="mb-4 text-3xl font-bold">Proximamente</h2>
      <p>Nuestro catalogo se esta actualizando con nuevos productos.</p>
    </div>
  )}

  {!isEmpty &&
    sections.map((section, index) => (
      <div
        class={`group reveal-on-scroll mx-auto mb-8 flex max-w-screen-2xl flex-col overflow-hidden rounded-[2.25rem] border border-outline-variant/70 bg-[linear-gradient(180deg,rgba(255,252,245,0.96),rgba(244,237,224,0.96))] shadow-[0_28px_70px_rgba(71,54,33,0.08)] ${index === 1 ? 'sm:flex-row-reverse' : 'sm:flex-row'}`}
        data-section={section.id}
        style={`transition-delay: ${index * 120}ms;`}
      >
        <div class="reveal-image relative h-[320px] w-full overflow-hidden sm:min-h-[620px] sm:w-1/2">
          {section.cat1Products.length > 0 && (
            <img
              class={`image-cat1-${section.id} absolute inset-0 z-10 h-full w-full object-cover opacity-100 transition-all duration-700 group-hover:scale-105`}
              alt={section.cat1Products[0].name}
              src={getProductImage(section.cat1Products[0])}
              loading="lazy"
            />
          )}

          {section.cat2Products.length > 0 && (
            <img
              class={`image-cat2-${section.id} absolute inset-0 z-0 h-full w-full object-cover opacity-0 transition-all duration-700 group-hover:scale-105`}
              alt={section.cat2Products[0].name}
              src={getProductImage(section.cat2Products[0])}
              loading="lazy"
            />
          )}

          <div class="absolute inset-0 z-20 bg-[linear-gradient(180deg,rgba(28,23,16,0.14),rgba(28,23,16,0.68))] pointer-events-none"></div>
          <div class="absolute left-5 top-5 z-30 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/12 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.22em] text-on-primary backdrop-blur-sm">
            <span class="material-symbols-outlined text-sm">auto_awesome</span>
            Curado para vender
          </div>
          <div class="absolute bottom-5 left-5 z-30 flex items-center">
            {section.previews.map((preview, previewIndex) => (
              <img
                src={preview.image}
                alt={preview.name}
                class={`h-14 w-14 rounded-full border-2 border-white/75 object-cover shadow-lg ${previewIndex > 0 ? '-ml-4' : ''}`}
                loading="lazy"
              />
            ))}
          </div>
        </div>

        <div class="reveal-content relative flex w-full flex-col justify-center p-6 pb-8 sm:w-1/2 sm:p-8 md:p-10 lg:p-12 xl:p-14">
          <div class="max-w-xl">
            {section.cat1Products.length > 0 && (
              <div class={`product-content content-cat1-${section.id} pointer-events-auto opacity-100 transition-opacity duration-500`}>
                <div class="flex flex-col">
                  <span class="mb-4 block text-xs font-bold uppercase tracking-[0.26em] text-secondary md:mb-5 lg:mb-6">
                    {section.cat1.name}
                  </span>

                  <h3 class="mb-4 font-headline text-3xl font-bold tracking-tight text-tertiary sm:mb-6 sm:text-4xl md:text-5xl">
                    {section.cat1Products[0].name}
                  </h3>

                  <p class="mb-5 text-sm leading-7 text-on-surface-variant sm:text-base lg:text-lg">
                    {section.cat1Products[0].description || 'Detalle premium con opciones de personalizacion.'}
                  </p>

                  <div class="mb-5 grid gap-3 sm:mb-6">
                    {getFeatures(section.cat1Products[0]).map((feature: string) => (
                      <div class="flex items-start gap-3 rounded-[1.1rem] bg-surface-container-low px-3 py-3">
                        <span class="material-symbols-outlined flex-shrink-0 text-lg text-secondary sm:text-xl">check_circle</span>
                        <p class="text-xs font-medium text-on-surface sm:text-sm lg:text-base">{feature}</p>
                      </div>
                    ))}
                  </div>

                  <div class="flex flex-col items-start gap-3 border-t border-outline-variant pt-4 sm:gap-4 sm:pt-5">
                    <div class="flex flex-col">
                      <span class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-on-surface-variant">Desde</span>
                      <span class="text-2xl font-extrabold text-tertiary sm:text-3xl">{formatPrice(section.cat1Products[0].price)}</span>
                    </div>

                    <div class="flex w-full flex-col items-stretch gap-2 xs:flex-row xs:items-center">
                      {section.cat2 && section.cat2Products.length > 0 && (
                        <div class="inline-flex h-11 flex-shrink-0 items-center gap-1 rounded-full border border-outline-variant bg-surface-container-low p-1">
                          <button
                            class={`cat-toggle-btn cat1-btn-${section.id} h-9 rounded-full bg-secondary px-4 text-xs font-semibold text-on-secondary shadow-sm transition-all duration-200`}
                            data-target={`cat1-${section.id}`}
                            data-section={section.id}
                          >
                            {getShortCategoryName(section.cat1.name)}
                          </button>
                          <button
                            class={`cat-toggle-btn cat2-btn-${section.id} h-9 rounded-full bg-transparent px-4 text-xs font-semibold text-on-surface-variant transition-all duration-200`}
                            data-target={`cat2-${section.id}`}
                            data-section={section.id}
                          >
                            {getShortCategoryName(section.cat2.name)}
                          </button>
                        </div>
                      )}

                      <a
                        class="group flex h-11 flex-1 items-center justify-center gap-1.5 rounded-full bg-primary px-5 text-sm font-semibold text-on-primary transition-all hover:-translate-y-0.5 hover:shadow-[0_16px_36px_rgba(102,114,80,0.22)] xs:flex-initial"
                        href={`/catalogo?categoria=${section.cat1.id}`}
                      >
                        <span class="material-symbols-outlined text-base">menu_book</span>
                        <span class="transition-transform group-hover:translate-x-0.5">Catalogo</span>
                        <span class="material-symbols-outlined -ml-1 text-sm opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">arrow_forward</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {section.cat2Products.length > 0 && (
              <div class={`product-content content-cat2-${section.id} pointer-events-none hidden opacity-0 transition-opacity duration-500`}>
                <div class="flex flex-col">
                  <span class="mb-4 block text-xs font-bold uppercase tracking-[0.26em] text-secondary md:mb-5 lg:mb-6">
                    {section.cat2.name}
                  </span>

                  <h3 class="mb-4 font-headline text-3xl font-bold tracking-tight text-tertiary sm:mb-6 sm:text-4xl md:text-5xl">
                    {section.cat2Products[0].name}
                  </h3>

                  <p class="mb-5 text-sm leading-7 text-on-surface-variant sm:text-base lg:text-lg">
                    {section.cat2Products[0].description || 'Detalle premium con opciones de personalizacion.'}
                  </p>

                  <div class="mb-5 grid gap-3 sm:mb-6">
                    {getFeatures(section.cat2Products[0]).map((feature: string) => (
                      <div class="flex items-start gap-3 rounded-[1.1rem] bg-surface-container-low px-3 py-3">
                        <span class="material-symbols-outlined flex-shrink-0 text-lg text-secondary sm:text-xl">check_circle</span>
                        <p class="text-xs font-medium text-on-surface sm:text-sm lg:text-base">{feature}</p>
                      </div>
                    ))}
                  </div>

                  <div class="flex flex-col items-start gap-3 border-t border-outline-variant pt-4 sm:gap-4 sm:pt-5">
                    <div class="flex flex-col">
                      <span class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-on-surface-variant">Desde</span>
                      <span class="text-2xl font-extrabold text-tertiary sm:text-3xl">{formatPrice(section.cat2Products[0].price)}</span>
                    </div>

                    <div class="flex w-full flex-col items-stretch gap-2 xs:flex-row xs:items-center">
                      {section.cat2 && section.cat2Products.length > 0 && (
                        <div class="inline-flex h-11 flex-shrink-0 items-center gap-1 rounded-full border border-outline-variant bg-surface-container-low p-1">
                          <button
                            class={`cat-toggle-btn cat1-btn-${section.id} h-9 rounded-full bg-transparent px-4 text-xs font-semibold text-on-surface-variant transition-all duration-200`}
                            data-target={`cat1-${section.id}`}
                            data-section={section.id}
                          >
                            {getShortCategoryName(section.cat1.name)}
                          </button>
                          <button
                            class={`cat-toggle-btn cat2-btn-${section.id} h-9 rounded-full bg-secondary px-4 text-xs font-semibold text-on-secondary shadow-sm transition-all duration-200`}
                            data-target={`cat2-${section.id}`}
                            data-section={section.id}
                          >
                            {getShortCategoryName(section.cat2.name)}
                          </button>
                        </div>
                      )}

                      <a
                        class="group flex h-11 flex-1 items-center justify-center gap-1.5 rounded-full bg-primary px-5 text-sm font-semibold text-on-primary transition-all hover:-translate-y-0.5 hover:shadow-[0_16px_36px_rgba(102,114,80,0.22)] xs:flex-initial"
                        href={`/catalogo?categoria=${section.cat2.id}`}
                      >
                        <span class="material-symbols-outlined text-base">menu_book</span>
                        <span class="transition-transform group-hover:translate-x-0.5">Catalogo</span>
                        <span class="material-symbols-outlined -ml-1 text-sm opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">arrow_forward</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtns = document.querySelectorAll('.cat-toggle-btn');
    const revealSections = document.querySelectorAll('.reveal-on-scroll');

    if (typeof window !== 'undefined' && 'IntersectionObserver' in window) {
      revealSections.forEach((section) => {
        section.classList.add('reveal-init');
      });

      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.18, rootMargin: '0px 0px -10% 0px' }
      );

      revealSections.forEach((section) => {
        revealObserver.observe(section);
      });
    } else {
      revealSections.forEach((section) => {
        section.classList.remove('reveal-init');
        section.classList.add('is-visible');
      });
    }

    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const sectionId = target.getAttribute('data-section');
        const targetCat = target.getAttribute('data-target');

        if (!sectionId || !targetCat) return;

        const isCat1 = targetCat.startsWith('cat1');
        const allBtn1s = document.querySelectorAll(`.cat1-btn-${sectionId}`);
        const allBtn2s = document.querySelectorAll(`.cat2-btn-${sectionId}`);

        if (isCat1) {
          allBtn1s.forEach((button) => {
            button.classList.add('bg-secondary', 'text-on-secondary', 'shadow-sm');
            button.classList.remove('bg-transparent', 'text-on-surface-variant');
          });
          allBtn2s.forEach((button) => {
            button.classList.remove('bg-secondary', 'text-on-secondary', 'shadow-sm');
            button.classList.add('bg-transparent', 'text-on-surface-variant');
          });
        } else {
          allBtn2s.forEach((button) => {
            button.classList.add('bg-secondary', 'text-on-secondary', 'shadow-sm');
            button.classList.remove('bg-transparent', 'text-on-surface-variant');
          });
          allBtn1s.forEach((button) => {
            button.classList.remove('bg-secondary', 'text-on-secondary', 'shadow-sm');
            button.classList.add('bg-transparent', 'text-on-surface-variant');
          });
        }

        const content1 = document.querySelector(`.content-cat1-${sectionId}`);
        const content2 = document.querySelector(`.content-cat2-${sectionId}`);
        const img1 = document.querySelector(`.image-cat1-${sectionId}`);
        const img2 = document.querySelector(`.image-cat2-${sectionId}`);

        if (isCat1) {
          content1?.classList.remove('hidden', 'opacity-0', 'pointer-events-none');
          content1?.classList.add('opacity-100', 'pointer-events-auto');
          content2?.classList.add('hidden', 'opacity-0', 'pointer-events-none');
          content2?.classList.remove('opacity-100', 'pointer-events-auto');
          img1?.classList.replace('opacity-0', 'opacity-100');
          img1?.classList.replace('z-0', 'z-10');
          img2?.classList.replace('opacity-100', 'opacity-0');
          img2?.classList.replace('z-10', 'z-0');
        } else {
          content2?.classList.remove('hidden', 'opacity-0', 'pointer-events-none');
          content2?.classList.add('opacity-100', 'pointer-events-auto');
          content1?.classList.add('hidden', 'opacity-0', 'pointer-events-none');
          content1?.classList.remove('opacity-100', 'pointer-events-auto');
          img2?.classList.replace('opacity-0', 'opacity-100');
          img2?.classList.replace('z-0', 'z-10');
          img1?.classList.replace('opacity-100', 'opacity-0');
          img1?.classList.replace('z-10', 'z-0');
        }
      });
    });
  });
</script>

<style>
  .reveal-on-scroll {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 700ms ease, transform 700ms ease;
    will-change: opacity, transform;
  }

  .reveal-on-scroll .reveal-image,
  .reveal-on-scroll .reveal-content {
    transform: translateX(0);
    transition: transform 850ms ease;
  }

  .reveal-on-scroll.reveal-init {
    opacity: 0;
    transform: translateY(42px);
  }

  .reveal-on-scroll.reveal-init .reveal-image {
    transform: translateX(-24px);
  }

  .reveal-on-scroll.reveal-init .reveal-content {
    transform: translateX(24px);
  }

  .reveal-on-scroll.reveal-init.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-on-scroll.reveal-init.is-visible .reveal-image,
  .reveal-on-scroll.reveal-init.is-visible .reveal-content {
    transform: translateX(0);
  }

  @media (max-width: 768px) {
    .reveal-on-scroll.reveal-init .reveal-image,
    .reveal-on-scroll.reveal-init .reveal-content {
      transform: translateY(16px);
    }

    .reveal-on-scroll.reveal-init.is-visible .reveal-image,
    .reveal-on-scroll.reveal-init.is-visible .reveal-content {
      transform: translateY(0);
    }
  }
</style>
