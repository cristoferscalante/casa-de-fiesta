---
interface Props {
  name: string;
  id: string;
  label: string;
  currentValue?: string;
  required?: boolean;
}

const { name, id, label, currentValue = '', required = false } = Astro.props;
---

<div>
  <label class="block text-[10px] font-bold text-on-surface mb-0.5">{label} {required && <span class="text-error">*</span>}</label>
  
  <!-- Hidden input to store the selected/uploaded image URL -->
  <input type="hidden" name={name} id={id} value={currentValue} />
  
  <!-- Image preview and controls -->
  <div class="border border-outline-variant rounded overflow-hidden bg-surface">
    <!-- Preview area -->
    <div class="w-full aspect-video bg-surface-container-low flex items-center justify-center relative group" id={`${id}-preview-container`}>
      {currentValue ? (
        <img src={currentValue} alt="Preview" class="w-full h-full object-cover" id={`${id}-preview-img`} />
      ) : (
        <div class="flex flex-col items-center gap-2 text-on-surface-variant" id={`${id}-preview-placeholder`}>
          <span class="material-symbols-outlined text-4xl">image</span>
          <span class="text-xs">Sin imagen</span>
        </div>
      )}
      
      <!-- Remove button (appears on hover if image exists) -->
      {currentValue && (
        <button
          type="button"
          class="absolute top-1 right-1 w-6 h-6 rounded-full bg-error/90 text-on-error flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"
          id={`${id}-remove-btn`}
          title="Quitar imagen"
        >
          <span class="material-symbols-outlined text-sm">close</span>
        </button>
      )}
    </div>
    
    <!-- Action buttons -->
    <div class="p-2 bg-surface-container-low border-t border-outline-variant flex gap-2">
      <button
        type="button"
        class="flex-1 px-2 py-1.5 rounded bg-primary text-on-primary text-xs font-semibold hover:brightness-110 transition-all flex items-center justify-center gap-1"
        id={`${id}-upload-btn`}
      >
        <span class="material-symbols-outlined text-sm">upload</span>
        Subir Nueva
      </button>
      <button
        type="button"
        class="flex-1 px-2 py-1.5 rounded bg-surface text-on-surface border border-outline-variant text-xs font-semibold hover:bg-surface-container transition-all flex items-center justify-center gap-1"
        id={`${id}-select-btn`}
      >
        <span class="material-symbols-outlined text-sm">photo_library</span>
        Seleccionar
      </button>
    </div>
  </div>
  
  <!-- Hidden file input for upload -->
  <input
    type="file"
    accept="image/*"
    class="hidden"
    id={`${id}-file-input`}
  />
</div>

<script define:vars={{ id, currentValue }}>
  const hiddenInput = document.getElementById(id);
  const previewContainer = document.getElementById(`${id}-preview-container`);
  const previewImg = document.getElementById(`${id}-preview-img`);
  const previewPlaceholder = document.getElementById(`${id}-preview-placeholder`);
  const removeBtn = document.getElementById(`${id}-remove-btn`);
  const uploadBtn = document.getElementById(`${id}-upload-btn`);
  const selectBtn = document.getElementById(`${id}-select-btn`);
  const fileInput = document.getElementById(`${id}-file-input`);
  
  // Update preview
  function updatePreview(url) {
    if (hiddenInput) hiddenInput.value = url || '';
    
    if (!url) {
      // Show placeholder
      if (previewImg) previewImg.classList.add('hidden');
      if (previewPlaceholder) {
        previewPlaceholder.classList.remove('hidden');
        previewPlaceholder.innerHTML = `
          <span class="material-symbols-outlined text-4xl">image</span>
          <span class="text-xs">Sin imagen</span>
        `;
      }
      if (removeBtn) removeBtn.classList.add('hidden');
    } else {
      // Show image
      if (previewPlaceholder) previewPlaceholder.classList.add('hidden');
      
      if (!previewImg) {
        const img = document.createElement('img');
        img.id = `${id}-preview-img`;
        img.src = url;
        img.alt = 'Preview';
        img.className = 'w-full h-full object-cover';
        previewContainer?.appendChild(img);
      } else {
        previewImg.src = url;
        previewImg.classList.remove('hidden');
      }
      
      // Show remove button
      if (!removeBtn) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.id = `${id}-remove-btn`;
        btn.className = 'absolute top-1 right-1 w-6 h-6 rounded-full bg-error/90 text-on-error flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity';
        btn.title = 'Quitar imagen';
        btn.innerHTML = '<span class="material-symbols-outlined text-sm">close</span>';
        btn.addEventListener('click', () => updatePreview(''));
        previewContainer?.appendChild(btn);
      } else {
        removeBtn.classList.remove('hidden');
      }
    }
  }
  
  // Remove button
  removeBtn?.addEventListener('click', () => updatePreview(''));
  
  // Upload button - trigger file input
  uploadBtn?.addEventListener('click', () => fileInput?.click());
  
  // File input change - upload to Cloudinary
  fileInput?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    
    // Show loading state
    if (previewPlaceholder) {
      previewPlaceholder.classList.remove('hidden');
      previewPlaceholder.innerHTML = `
        <span class="material-symbols-outlined text-4xl animate-spin">progress_activity</span>
        <span class="text-xs">Subiendo...</span>
      `;
    }
    if (previewImg) previewImg.classList.add('hidden');
    
    // Upload to Cloudinary
    const formData = new FormData();
    formData.append('file', file);
    
    try {
      const response = await fetch('/api/upload', {
        method: 'POST',
        body: formData,
      });
      
      if (!response.ok) {
        throw new Error('Error al subir la imagen');
      }
      
      const data = await response.json();
      updatePreview(data.url);
      
      // Clear file input
      if (fileInput) fileInput.value = '';
    } catch (error) {
      console.error('Upload error:', error);
      alert('Error al subir la imagen. Por favor intenta de nuevo.');
      updatePreview(currentValue);
    }
  });
  
  // Select button - open image selector modal
  selectBtn?.addEventListener('click', () => {
    window.openImageSelectorModal?.(id);
  });
</script>
