<!-- Mobile menu overlay - OUTSIDE nav for proper z-index stacking -->
<div id="mobile-menu" class="md:hidden fixed inset-0 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 z-[9999]">
  <!-- Slide-in menu panel -->
  <div id="mobile-menu-panel" class="absolute right-0 top-0 h-full w-80 max-w-[85vw] bg-white shadow-2xl transform translate-x-full transition-transform duration-300 overflow-y-auto z-[10000]">
    <!-- Close button at top -->
    <div class="flex items-center justify-between p-4 border-b border-gray-100 bg-white">
      <img src="/logo-h.png" alt="Mister LyA" class="h-8 w-auto" />
      <button id="mobile-menu-close" class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 transition-colors">
        <span class="material-symbols-outlined text-xl text-gray-600">close</span>
      </button>
    </div>
    
    <div class="flex flex-col h-[calc(100%-72px)] pt-4 px-6 bg-white">
      <!-- Menu items -->
      <div class="flex flex-col gap-1">
        <a class="menu-item group flex items-center gap-4 text-slate-700 hover:text-primary hover:bg-primary/5 transition-all py-3.5 px-3 rounded-xl" href="/">
