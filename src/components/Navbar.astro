<div id="mobile-menu" class="fixed inset-0 z-[9999] bg-on-surface/40 opacity-0 pointer-events-none backdrop-blur-sm transition-opacity duration-300 md:hidden">
  <div id="mobile-menu-panel" class="absolute right-0 top-0 flex h-full w-80 max-w-[86vw] translate-x-full flex-col bg-[linear-gradient(180deg,#fffdf7_0%,#f3ebde_100%)] p-5 shadow-2xl transition-transform duration-300">
    <div class="mb-6 flex items-center justify-between">
      <img src="/logo-circle.webp" alt="Casa de Fiestas" class="h-12 w-12 rounded-full object-cover shadow-[0_4px_12px_rgba(115,59,10,0.12)] border border-secondary/15" />
      <button id="mobile-menu-close" class="flex h-10 w-10 items-center justify-center rounded-full bg-surface-container-low text-tertiary">
        <span class="material-symbols-outlined text-xl">close</span>
      </button>
    </div>

    <div class="space-y-2">
      <a class="menu-item flex items-center justify-between rounded-[1.25rem] bg-white/70 px-4 py-4 text-sm font-semibold text-tertiary transition-colors hover:bg-white" href="/">
        <span>Inicio</span>
        <span class="material-symbols-outlined text-base text-secondary">arrow_forward</span>
      </a>
      <a class="menu-item flex items-center justify-between rounded-[1.25rem] bg-white/70 px-4 py-4 text-sm font-semibold text-tertiary transition-colors hover:bg-white" href="/catalogo">
        <span>Catalogo</span>
        <span class="material-symbols-outlined text-base text-secondary">arrow_forward</span>
      </a>
      <a class="menu-item flex items-center justify-between rounded-[1.25rem] bg-white/70 px-4 py-4 text-sm font-semibold text-tertiary transition-colors hover:bg-white" href="/#mision">
        <span>Nosotros</span>
        <span class="material-symbols-outlined text-base text-secondary">arrow_forward</span>
      </a>
      <a class="menu-item flex items-center justify-between rounded-[1.25rem] bg-white/70 px-4 py-4 text-sm font-semibold text-tertiary transition-colors hover:bg-white" href="/login">
        <span>Admin</span>
        <span class="material-symbols-outlined text-base text-secondary">arrow_forward</span>
      </a>
    </div>

    <a
      href="https://wa.me/573152183173"
      target="_blank"
      class="mt-auto inline-flex items-center justify-center gap-2 rounded-full bg-secondary px-5 py-3.5 text-sm font-bold text-on-secondary shadow-[0_16px_38px_rgba(115,59,10,0.2)]"
    >
      <span class="material-symbols-outlined text-lg">chat</span>
      315 218 3173
    </a>
  </div>
</div>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenuClose = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuPanel = document.getElementById('mobile-menu-panel');
  const hamburgerLines = mobileMenuBtn?.querySelectorAll('.hamburger-line');

  function toggleMenu() {
    const isOpen = mobileMenu?.classList.contains('opacity-100');

    if (isOpen) {
      mobileMenu?.classList.remove('opacity-100');
      mobileMenu?.classList.add('opacity-0', 'pointer-events-none');
      mobileMenuPanel?.classList.remove('translate-x-0');
      mobileMenuPanel?.classList.add('translate-x-full');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';

      if (hamburgerLines) {
        hamburgerLines[0].classList.remove('rotate-45', 'translate-y-2');
        hamburgerLines[1].classList.remove('opacity-0');
        hamburgerLines[2].classList.remove('-rotate-45', '-translate-y-2');
      }
    } else {
      mobileMenu?.classList.remove('opacity-0', 'pointer-events-none');
      mobileMenu?.classList.add('opacity-100');
      mobileMenuPanel?.classList.remove('translate-x-full');
      mobileMenuPanel?.classList.add('translate-x-0');
      mobileMenuBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';

      if (hamburgerLines) {
        hamburgerLines[0].classList.add('rotate-45', 'translate-y-2');
        hamburgerLines[1].classList.add('opacity-0');
        hamburgerLines[2].classList.add('-rotate-45', '-translate-y-2');
      }
    }
  }

  mobileMenuBtn?.addEventListener('click', toggleMenu);
  mobileMenuClose?.addEventListener('click', toggleMenu);

  mobileMenu?.addEventListener('click', (event) => {
    if (event.target === mobileMenu) {
      toggleMenu();
    }
  });

  const menuLinks = mobileMenuPanel?.querySelectorAll('a');
  menuLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      toggleMenu();
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenu?.classList.contains('opacity-100')) {
      toggleMenu();
    }
  });
</script>

<style>
  .navbar-animate {
    animation: slideDown 0.6s ease-out forwards;
  }

  @keyframes slideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>
