          <span class="font-semibold text-base">Catálogo</span>
          <span class="material-symbols-outlined ml-auto text-slate-400 group-hover:translate-x-1 transition-transform text-lg">arrow_forward</span>
        </a>
        <a class="menu-item group flex items-center gap-4 text-slate-700 hover:text-primary hover:bg-primary/5 transition-all py-3.5 px-3 rounded-xl" href="/#mision">
          <span class="material-symbols-outlined text-xl text-primary">stars</span>
          <span class="font-semibold text-base">Nuestra Esencia</span>
          <span class="material-symbols-outlined ml-auto text-slate-400 group-hover:translate-x-1 transition-transform text-lg">arrow_forward</span>
        </a>
        <a class="menu-item group flex items-center gap-4 text-slate-700 hover:text-primary hover:bg-primary/5 transition-all py-3.5 px-3 rounded-xl" href="https://wa.me/573115412230" target="_blank">
          <span class="material-symbols-outlined text-xl text-green-600">chat</span>
          <span class="font-semibold text-base">Contacto</span>
          <span class="material-symbols-outlined ml-auto text-slate-400 group-hover:translate-x-1 transition-transform text-lg">open_in_new</span>
