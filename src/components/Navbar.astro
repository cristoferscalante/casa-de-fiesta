          <span class="font-semibold text-base">Inicio</span>
          <span class="material-symbols-outlined ml-auto text-slate-400 group-hover:translate-x-1 transition-transform text-lg">arrow_forward</span>
        </a>
        <a class="menu-item group flex items-center gap-4 text-slate-700 hover:text-primary hover:bg-primary/5 transition-all py-3.5 px-3 rounded-xl" href="/catalogo">
