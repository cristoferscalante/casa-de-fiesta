---
import { products as localCatalogProducts } from '../data/catalogCasaDeFiestas';

interface Props {
  products?: any[];
}

const { products = [] } = Astro.props;
const activeProducts = products.filter((product) => product?.active !== false);
const ctaProducts = (activeProducts.length > 0 ? activeProducts : localCatalogProducts).slice(0, 3);
---

<section class="px-5 py-16 md:px-8 md:py-20 lg:px-12 lg:py-24">
  <div class="mx-auto max-w-screen-2xl">
    <div class="hero-gradient ambient-border relative overflow-hidden rounded-[2.5rem] px-6 py-12 shadow-[0_36px_90px_rgba(71,54,33,0.18)] md:px-10 md:py-16 lg:px-14">
      <div class="absolute left-0 top-0 h-64 w-64 rounded-full bg-white/10 blur-3xl"></div>
      <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-secondary/20 blur-3xl"></div>
      <div class="absolute inset-0 opacity-15" style="background-image: linear-gradient(rgba(255,248,236,0.25) 1px, transparent 1px), linear-gradient(90deg, rgba(255,248,236,0.25) 1px, transparent 1px); background-size: 24px 24px;"></div>

      <div class="relative z-10 mx-auto max-w-4xl text-center text-on-primary">
        <div class="mb-8 flex justify-center">
          <div class="flex items-center">
            {ctaProducts.map((product, index) => (
              <img
                src={product.image || '/logo-mark.svg'}
                alt={product.name || 'Producto Casa de Fiestas'}
                class={`h-16 w-16 rounded-full border-4 border-white/70 object-cover shadow-lg md:h-20 md:w-20 ${index > 0 ? '-ml-4' : ''}`}
                loading="lazy"
              />
            ))}
          </div>
        </div>

        <span class="section-kicker mb-4 inline-flex !text-secondary-fixed text-[11px] font-bold">Globos, combos y accesorios</span>
        <h2 class="font-headline text-4xl font-bold leading-tight md:text-6xl">
          Desde un globo Sempertex hasta un arreglo completo para cualquier ocasion.
        </h2>
        <p class="mx-auto mt-5 max-w-3xl text-base leading-8 text-on-primary/78 md:text-lg">
          La web ahora debe llevar al cliente directo a la accion: elegir colores, tipos, tamanos, pedir un combo
          decorativo o completar su compra con aretes, collares, pulseras, rosarios y otros detalles especiales.
        </p>

        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="https://wa.me/573152183173?text=Hola%2C%20quiero%20cotizar%20globos%20Sempertex%20y%20un%20arreglo"
            target="_blank"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-secondary px-8 py-4 text-base font-bold text-on-secondary transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_22px_50px_rgba(115,59,10,0.24)] sm:w-auto"
          >
            <span class="material-symbols-outlined text-lg">chat</span>
            Cotizar mi pedido
          </a>
          <a
            href="/catalogo"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-white/25 bg-white/10 px-8 py-4 text-base font-bold text-on-primary backdrop-blur-sm transition-all duration-300 hover:bg-white/16 sm:w-auto"
          >
            <span class="material-symbols-outlined text-lg">menu_book</span>
            Explorar catalogo
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
