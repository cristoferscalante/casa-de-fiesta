---
import {
  findVariantBySelection,
  getVariantDefaultSelection,
  getVariantDisplayLabel,
  getVariantGroups,
  normalizeProductVariants,
} from '../lib/product-variants';

interface Props {
	products: any[];
	categories: any[];
}

const { products, categories } = Astro.props;
const normalizedProducts = products.map((product) => {
  const variants = normalizeProductVariants(product.variants);
  const variantGroups = getVariantGroups(variants);
  const defaultSelection = getVariantDefaultSelection(variants);
  const selectedVariant = findVariantBySelection(variants, defaultSelection) || variants[0] || null;

  return {
    ...product,
    variants,
    variantGroups,
    defaultSelection,
    selectedVariant,
  };
});

const previewCategories = categories.slice(0, 3);
const totalProducts = normalizedProducts.length;
const totalCategories = categories.length;
const formatPrice = (value: number) =>
  new Intl.NumberFormat('es-CO', {
    style: 'currency',
    currency: 'COP',
    maximumFractionDigits: 0,
  }).format(value);

---

<!-- Hero Section with Title, Filters, and Categories -->
<section id="catalog-hero" class="relative min-h-[78vh] flex items-center justify-center overflow-hidden bg-[linear-gradient(135deg,#667250_0%,#828c6c_46%,#733b0a_100%)]">
  <!-- Animated background shapes -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(242,219,213,0.12),transparent_45%),radial-gradient(circle_at_82%_78%,rgba(242,219,213,0.08),transparent_42%)]"></div>
    <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(rgba(242,219,213,0.12) 1px, transparent 1px); background-size: 20px 20px;"></div>
    <div class="absolute top-20 left-10 w-56 h-56 bg-on-primary/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-20 right-10 w-72 h-72 bg-secondary/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
  </div>
  
  <div class="max-w-screen-2xl mx-auto px-4 md:px-8 py-10 md:py-14 relative z-10 w-full">
    <div class="grid items-center gap-8 mb-8 lg:grid-cols-[1fr_0.9fr]">
      <div>
        <span class="mb-4 inline-flex text-[11px] font-bold uppercase tracking-[0.28em] text-secondary-fixed">Catalogo Sempertex y celebraciones</span>
        <h2 class="font-headline text-4xl md:text-6xl font-bold text-on-primary tracking-tight">
          Globos de todos los tipos, arreglos por ocasion y accesorios para complementar.
        </h2>
        <p class="text-on-primary/84 text-sm md:text-base max-w-2xl leading-7 mt-4">
          Aqui el cliente puede descubrir primero globos Sempertex en variedad de colores, tamanos y acabados, y despues avanzar a combos decorativos, detalles especiales y accesorios.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <div class="rounded-full border border-white/18 bg-white/10 px-4 py-2 text-sm font-semibold text-on-primary backdrop-blur-sm">
            {totalProducts}+ productos
          </div>
          <div class="rounded-full border border-white/18 bg-white/10 px-4 py-2 text-sm font-semibold text-on-primary backdrop-blur-sm">
            {totalCategories} categorias
          </div>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        {previewCategories.map((category, categoryIndex) => (
          <article class={`overflow-hidden rounded-[1.75rem] border border-white/18 bg-white/10 backdrop-blur-md shadow-[0_18px_45px_rgba(41,32,21,0.16)] ${categoryIndex === 0 ? 'sm:col-span-2 sm:row-span-2' : ''}`}>
            <div class={`${categoryIndex === 0 ? 'h-60 sm:h-full' : 'h-28 sm:h-32'} relative`}>
              {category.image ? (
                <img src={category.image} alt={category.name} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-white/10">
                  <span class="material-symbols-outlined text-4xl text-on-primary">{category.icon}</span>
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(28,23,16,0.72)] via-transparent to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-4">
                <p class="font-headline text-2xl font-bold text-on-primary">{category.name}</p>
                <p class="mt-1 text-xs leading-5 text-on-primary/80">{category.description}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Title and Description -->
    <div class="text-center mb-8 lg:hidden">
      <h1 class="font-headline text-3xl md:text-5xl font-extrabold text-on-primary mb-4 tracking-tighter">
        Nuestro Catalogo
      </h1>
      <p class="text-on-primary/90 text-sm md:text-base max-w-xl mx-auto mb-6">
        Explora globos Sempertex, decoracion para fiestas, arreglos para ocasiones especiales y accesorios para regalar.
      </p>
    </div>

    <!-- Filters Container -->
    <div class="luxury-panel ambient-border max-w-5xl mx-auto rounded-[2rem] p-4 md:p-6 mb-8 relative">
      <div>
        <!-- Search Bar -->
        <div class="relative mb-3">
          <label for="product-search" class="text-[10px] font-bold text-on-surface-variant mb-1.5 block uppercase tracking-[0.22em]">
            Buscar Producto
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <span class="material-symbols-outlined text-lg text-on-surface-variant">search</span>
            </div>
            <input
              type="text"
              id="product-search"
              placeholder="Nombre del producto..."
              autocomplete="off"
              class="w-full pl-10 pr-10 py-3 text-sm bg-surface-container-low rounded-2xl border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary text-on-surface placeholder-on-surface-variant transition-all"
            />
            <button
              id="clear-search"
              class="absolute inset-y-0 right-0 pr-3 flex items-center opacity-0 pointer-events-none transition-opacity duration-200"
              aria-label="Limpiar búsqueda"
            >
              <span class="material-symbols-outlined text-lg text-on-surface-variant hover:text-primary transition-colors cursor-pointer">close</span>
            </button>
            
            <!-- Autocomplete dropdown -->
            <div id="autocomplete-dropdown" class="autocomplete-dropdown absolute top-full left-0 right-0 mt-1.5 bg-surface rounded-2xl shadow-xl border border-outline-variant overflow-hidden opacity-0 pointer-events-none transition-all duration-200 z-50">
            </div>
          </div>
        </div>

        <div>
          <div class="grid grid-cols-2 md:grid-cols-4 xl:grid-cols-5 gap-2">
            <button class="category-card category-all-btn group relative px-2 py-2 bg-surface/90 backdrop-blur-sm rounded-[1.3rem] border border-outline-variant shadow-sm hover:-translate-y-0.5 hover:shadow-md transition-all duration-300" data-category="">
              <div class="flex items-center justify-center gap-1.5">
                <div class="category-avatar w-8 h-8 rounded-full bg-primary/10 border border-primary/15 flex items-center justify-center">
                  <span class="material-symbols-outlined text-xs text-primary">apps</span>
                </div>
                <h3 class="font-semibold text-xs text-primary leading-tight">Todas</h3>
              </div>
            </button>
            {categories.map((category) => (
              <button 
                class="category-card group relative px-2 py-2 bg-surface/90 backdrop-blur-sm rounded-[1.3rem] border border-outline-variant shadow-sm hover:-translate-y-0.5 hover:shadow-md transition-all duration-300"
                data-category={category.id}
              >
                <div class="flex items-center justify-center gap-1.5">
                  <div class="category-avatar w-8 h-8 rounded-full flex items-center justify-center overflow-hidden bg-primary/5 border border-primary/10">
                    {category.image ? (
                      <img src={category.image} alt={category.name} class="w-full h-full object-cover" loading="lazy" />
                    ) : (
                      <span class="material-symbols-outlined text-xs text-primary">{category.icon}</span>
                    )}
                  </div>
                  <h3 class="font-semibold text-xs text-primary leading-tight line-clamp-1">
                    {category.name}
                  </h3>
                </div>
              </button>
            ))}
          </div>
        </div>
        
        <!-- Download PDF Button -->
        <div class="flex justify-center mt-4">
          <button id="download-pdf-btn" class="flex items-center gap-1.5 bg-secondary-container hover:bg-surface-container-high text-on-secondary-container px-5 py-2.5 rounded-full transition-all text-xs font-bold border border-outline-variant/60 hover:-translate-y-0.5">
            <span class="material-symbols-outlined text-base">download</span>
            <span>Descargar Catálogo PDF</span>
          </button>
        </div>
      </div>
      
    </div>

    
  </div>
</section>
<!-- Products Section -->
<!-- PDF Cover Page (hidden, only shows in print) -->
<section id="pdf-cover" class="hidden print:flex print:flex-col print:items-center print:justify-center print:h-screen print:bg-surface print:relative">
  <div class="print:absolute print:inset-0 print:opacity-5" style="background-image: radial-gradient(#8C2D18 1px, transparent 1px); background-size: 24px 24px;"></div>
  <div class="print:relative print:z-10 print:flex print:flex-col print:items-center">
    <img src="/logo-circle.webp" alt="Casa de Fiestas" class="h-32 w-32 rounded-full object-cover shadow-lg border border-secondary/20 mb-8" />
    <h1 class="text-5xl font-bold text-primary tracking-tight mb-4">Catálogo de Productos</h1>
    <div class="w-24 h-1 bg-primary rounded-full mb-4"></div>
    <p class="text-xl text-on-surface-variant mb-8">Casa de Fiestas - Creamos momentos, diseñamos recuerdos</p>
    <div class="flex items-center gap-6 text-sm text-on-surface-variant">
      <span class="flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">phone</span>
        315 218 3173
      </span>
      <span class="flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">location_on</span>
        Bogotá, Colombia
      </span>
    </div>
  </div>
</section>

<section 
  class="relative py-12 transition-all duration-700 bg-[linear-gradient(180deg,#f3ecde_0%,#f8f3e8_100%)]" 
  id="products-section"
  data-active-category=""
>
  <div class="absolute inset-0 opacity-20 pointer-events-none" style="background-image: radial-gradient(rgba(166,128,83,0.12) 1px, transparent 1px); background-size: 20px 20px;"></div>
  <div class="max-w-screen-2xl mx-auto px-4 md:px-8 flex flex-col">
    
    <!-- Products by Category -->
    {categories.map((category, index) => {
      const categoryProducts = normalizedProducts.filter(p => p.categoryId === category.id);
      const bgColor = 'bg-surface';
      
      return (
        <table 
          class="category-section category-table mb-12 transition-all duration-500 w-full border-collapse"
          id={`category-${category.id}`}
          data-category={category.id}
        >
          <!-- Category Header - repeats on each page in print -->
          <thead class="category-header">
            <tr>
              <th colspan="5" class="p-0">
                <div class={`relative rounded-xl p-5 md:p-8 mb-6 overflow-hidden border border-outline-variant shadow-sm ${bgColor}`}>
                  <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(120deg, rgba(140,45,24,0.08), rgba(242,219,213,0) 45%), radial-gradient(rgba(140,45,24,0.08) 1px, transparent 1px); background-size: auto, 18px 18px;"></div>
                  <div class="absolute inset-0 opacity-15">
                    <div class="absolute top-0 right-0 w-48 h-48 bg-primary/10 rounded-full blur-3xl"></div>
                    <div class="absolute bottom-0 left-0 w-64 h-64 bg-secondary/10 rounded-full blur-3xl"></div>
                  </div>
                  
                  <div class="relative z-10 flex items-center gap-4">
                    <div class="w-14 h-14 md:w-16 md:h-16 bg-surface rounded-xl shadow-md flex items-center justify-center overflow-hidden category-icon border border-outline-variant/60">
                      {category.image ? (
                        <img src={category.image} alt={category.name} class="w-full h-full object-cover" loading="lazy" />
                      ) : (
                        <span class="material-symbols-outlined text-3xl md:text-4xl text-primary">{category.icon}</span>
                      )}
                    </div>
                    <div>
                        <h2 class="font-headline text-xl md:text-3xl font-bold tracking-tight mb-1 text-primary text-left">
                          {category.name}
                        </h2>
                      <p class="text-on-surface-variant text-sm text-left">{category.description}</p>
                    </div>
                  </div>
                </div>
              </th>
            </tr>
          </thead>

          <!-- Products Grid -->
          <tbody>
            <tr>
              <td colspan="5" class="p-0">
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 products-grid">
            {categoryProducts.map((product, prodIndex) => (
                <div 
                class="product-card h-full bg-surface rounded-lg overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 group flex flex-col border border-outline-variant/60"
                style={`animation-delay: ${prodIndex * 50}ms;`}
                data-product-name={product.name.toLowerCase()}
                data-product-description={product.description.toLowerCase()}
                data-product-price={product.price}
                data-product-base-price={product.price}
                data-product-base-image={product.image || ''}
                data-product-images={JSON.stringify([product.image, ...(product.images || [])].filter(Boolean))}
                data-product-variants={JSON.stringify(product.variants || [])}
                data-product-default-selection={JSON.stringify(product.defaultSelection || {})}
              >
                <div class="aspect-square overflow-hidden bg-surface-container-highest relative product-image-container">
                  {/* Main image */}
                  <img 
                    src={product.image} 
                    alt={product.name}
                    class="product-main-image w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    data-index="0"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-on-surface/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                  
                  {/* Image navigation arrows - only show if product has multiple images */}
                  {product.images && product.images.length > 0 && (
                    <>
                      <button 
                        class="product-img-prev absolute left-1 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-surface/90 shadow flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 hover:bg-surface z-10 border border-outline-variant/60"
                        aria-label="Imagen anterior"
                      >
                        <span class="material-symbols-outlined text-primary text-sm">chevron_left</span>
                      </button>
                      <button 
                        class="product-img-next absolute right-1 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-surface/90 shadow flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 hover:bg-surface z-10 border border-outline-variant/60"
                        aria-label="Siguiente imagen"
                      >
                        <span class="material-symbols-outlined text-primary text-sm">chevron_right</span>
                      </button>
                      
                      {/* Dot indicators */}
                      <div class="absolute bottom-1.5 left-1/2 -translate-x-1/2 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10">
                        <span class="product-img-dot w-1.5 h-1.5 rounded-full bg-on-primary shadow-sm cursor-pointer transition-all active" data-index="0"></span>
                        {product.images.map((_, imgIndex) => (
                          <span class="product-img-dot w-1.5 h-1.5 rounded-full bg-on-primary/60 shadow-sm cursor-pointer transition-all hover:bg-on-primary/80" data-index={imgIndex + 1}></span>
                        ))}
                      </div>
                    </>
                  )}
                </div>
                
                <div class="p-2.5 md:p-3 flex flex-col flex-1">
                  <h4 class="font-headline font-bold text-xs md:text-sm text-primary mb-1 line-clamp-2 group-hover:text-secondary transition-colors">
                    {product.name}
                  </h4>
                  <p class="text-[10px] md:text-xs text-on-surface-variant mb-2 line-clamp-2">
                    {product.description}
                  </p>

                  <div class="mb-3 rounded-2xl bg-surface-container-low px-3 py-2.5">
                    <p class="text-[9px] font-bold uppercase tracking-[0.18em] text-secondary">Precio</p>
                    <p class="product-price mt-1 text-sm font-bold text-primary">
                      {product.selectedVariant?.price ? formatPrice(product.selectedVariant.price) : product.price ? formatPrice(product.price) : 'Consultar'}
                    </p>
                    <p class="product-selected-variant mt-1 text-[10px] text-on-surface-variant">
                      {product.selectedVariant ? getVariantDisplayLabel(product.selectedVariant) : 'Sin variante seleccionada'}
                    </p>
                  </div>
                   
                  {product.variantGroups.length > 0 ? (
                    <div class="product-variant-groups mb-3 space-y-2">
                      {product.variantGroups.map((group) => (
                        <div class="space-y-1" data-variant-group={group.name}>
                          <p class="text-[9px] font-semibold uppercase tracking-[0.16em] text-secondary">{group.name}</p>
                          <div class="flex flex-wrap gap-1.5">
                            {group.values.map((value) => (
                              <button
                                type="button"
                                class={`variant-option-btn rounded-full border px-2.5 py-1 text-[10px] font-semibold transition-all ${product.defaultSelection[group.name] === value ? 'border-secondary bg-secondary/12 text-secondary' : 'border-outline-variant bg-surface-container text-on-surface-variant hover:border-secondary/50 hover:text-secondary'}`}
                                data-attribute-name={group.name}
                                data-attribute-value={value}
                                aria-pressed={product.defaultSelection[group.name] === value ? 'true' : 'false'}
                              >
                                {value}
                              </button>
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                  ) : null}

                  <div class="mt-auto">
                    <div class="product-actions grid grid-cols-2 gap-1.5">
                      <button 
                        class="add-to-cart-btn w-full h-7 bg-surface-container-high text-primary rounded text-[10px] font-semibold hover:bg-surface-container-highest transition-all flex items-center justify-center gap-1"
                        data-product-id={product.id}
                        data-product-name={product.name}
                        data-product-sku={product.sku}
                        data-product-price={product.price}
                        data-product-image={product.selectedVariant?.image || product.image}
                        data-product-variant-id={product.selectedVariant?.id || ''}
                        data-product-variant-label={product.selectedVariant ? getVariantDisplayLabel(product.selectedVariant) : ''}
                      >
                        <span class="material-symbols-outlined text-xs">add_shopping_cart</span>
                        <span class="hidden sm:inline">Agregar</span>
                      </button>

                      <button 
                        class="whatsapp-btn w-full h-7 bg-primary text-on-primary rounded text-[10px] font-semibold hover:bg-primary-container hover:scale-95 transition-all flex items-center justify-center gap-1 group-hover:shadow"
                        data-product-id={product.id}
                        data-product-name={product.name}
                        data-product-sku={product.sku}
                        data-product-price={product.selectedVariant?.price || product.price}
                        data-product-variant-id={product.selectedVariant?.id || ''}
                        data-product-variant-label={product.selectedVariant ? getVariantDisplayLabel(product.selectedVariant) : ''}
                      >
                        <span class="product-whatsapp-price text-[9px] sm:text-[10px]">{product.selectedVariant?.price || product.price ? formatPrice(product.selectedVariant?.price || product.price) : 'Consultar'}</span>
                        <span class="material-symbols-outlined text-xs">arrow_forward</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            ))}
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      );
    })}
  </div>
</section>

<button id="cart-toggle" class="print-hidden fixed right-4 bottom-4 z-40 bg-primary text-on-primary rounded-full w-11 h-11 shadow-lg hover:scale-95 transition-all flex items-center justify-center">
  <span class="material-symbols-outlined text-xl">shopping_cart</span>
  <span id="cart-count-badge" class="absolute -top-0.5 -right-0.5 bg-secondary text-on-secondary text-[10px] font-bold min-w-4 h-4 px-0.5 rounded-full flex items-center justify-center">0</span>
</button>

<div id="cart-overlay" class="print-hidden fixed inset-0 bg-on-surface/35 z-40 opacity-0 pointer-events-none transition-opacity duration-300"></div>

<aside id="cart-drawer" class="print-hidden fixed top-0 right-0 h-full w-full max-w-sm bg-surface z-50 shadow-2xl translate-x-full transition-transform duration-300 flex flex-col border-l border-outline-variant/70">
  <div class="p-3 border-b border-surface-container-high flex items-center justify-between">
    <div>
      <h3 class="font-headline text-lg font-bold text-primary">Carrito</h3>
      <p id="cart-subtitle" class="text-xs text-on-surface-variant">No hay productos</p>
    </div>
    <button id="cart-close" class="w-8 h-8 rounded bg-surface-container hover:bg-surface-container-high flex items-center justify-center">
      <span class="material-symbols-outlined text-lg">close</span>
    </button>
  </div>

  <div id="cart-items" class="flex-1 overflow-y-auto p-2.5 space-y-2"></div>

  <div id="cart-empty" class="flex-1 p-4 text-center text-on-surface-variant">
    <span class="material-symbols-outlined text-4xl mb-1.5 block">shopping_cart</span>
    <p class="text-sm">Agrega productos para enviar tu pedido.</p>
  </div>

  <div class="p-2.5 border-t border-surface-container-high space-y-1.5">
    <button id="cart-continue-shopping" class="w-full py-2 rounded bg-surface-container text-on-surface text-sm font-semibold hover:bg-surface-container-high transition-colors flex items-center justify-center gap-1.5">
      <span class="material-symbols-outlined text-sm">arrow_back</span>
      <span>Seguir Comprando</span>
    </button>
    <button id="cart-clear" class="w-full py-2 rounded bg-surface-container text-on-surface text-sm font-semibold hover:bg-surface-container-high transition-colors">
      Vaciar carrito
    </button>
    <button id="cart-send-whatsapp" class="w-full py-2 rounded bg-primary text-on-primary text-sm font-bold hover:bg-primary-container transition-colors flex items-center justify-center gap-1.5">
      <span class="material-symbols-outlined text-sm">send</span>
      <span>Enviar por WhatsApp</span>
    </button>
  </div>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.body.classList.add('catalog-mounted');

    // Elements
    const searchInput = document.getElementById('product-search') as HTMLInputElement;
    const clearSearchBtn = document.getElementById('clear-search') as HTMLButtonElement;
    const autocompleteDropdown = document.getElementById('autocomplete-dropdown') as HTMLDivElement;
    const categorySections = document.querySelectorAll('.category-section');
    const categoryCards = document.querySelectorAll('.category-card');
    const cartToggleBtn = document.getElementById('cart-toggle') as HTMLButtonElement;
    const cartCloseBtn = document.getElementById('cart-close') as HTMLButtonElement;
    const cartOverlay = document.getElementById('cart-overlay') as HTMLDivElement;
    const cartDrawer = document.getElementById('cart-drawer') as HTMLElement;
    const cartItemsContainer = document.getElementById('cart-items') as HTMLDivElement;
    const cartEmptyState = document.getElementById('cart-empty') as HTMLDivElement;
    const cartCountBadge = document.getElementById('cart-count-badge') as HTMLSpanElement;
    const cartSubtitle = document.getElementById('cart-subtitle') as HTMLParagraphElement;
    const cartClearBtn = document.getElementById('cart-clear') as HTMLButtonElement;
    const cartSendBtn = document.getElementById('cart-send-whatsapp') as HTMLButtonElement;

    let currentSearchTerm = '';
    let currentCategory = '';
    let allProducts: Array<{name: string, description: string, category: string, image: string, price: number}> = [];
    const cart = new Map<string, { id: string; key: string; name: string; sku: string; variantLabel: string; price: number; quantity: number; image: string }>();

    const formatPrice = (value: number) => `$${(value / 1000).toFixed(3).replace('.', ',')} COP`;

    function openCart() {
      cartDrawer.classList.remove('translate-x-full');
      cartOverlay.classList.remove('opacity-0', 'pointer-events-none');
    }

    function closeCart() {
      cartDrawer.classList.add('translate-x-full');
      cartOverlay.classList.add('opacity-0', 'pointer-events-none');
    }

    function updateCartBadge() {
      const totalItems = Array.from(cart.values()).reduce((sum, item) => sum + item.quantity, 0);
      cartCountBadge.textContent = String(totalItems);
      cartCountBadge.style.display = totalItems > 0 ? 'flex' : 'none';
      cartSubtitle.textContent = totalItems > 0 ? `${totalItems} producto${totalItems > 1 ? 's' : ''} en tu carrito` : 'No hay productos seleccionados';
    }

    function renderCart() {
      const items = Array.from(cart.values());
      if (items.length === 0) {
        cartItemsContainer.innerHTML = '';
        cartItemsContainer.style.display = 'none';
        cartEmptyState.style.display = 'block';
        cartSendBtn.disabled = true;
        cartSendBtn.classList.add('opacity-60', 'cursor-not-allowed');
        updateCartBadge();
        return;
      }

      cartItemsContainer.style.display = 'block';
      cartEmptyState.style.display = 'none';
      cartSendBtn.disabled = false;
      cartSendBtn.classList.remove('opacity-60', 'cursor-not-allowed');

      cartItemsContainer.innerHTML = items.map((item) => `
        <div class="border border-surface-container-high rounded-lg p-2.5 bg-surface">
          <div class="flex items-start justify-between gap-3 mb-2">
            <div class="flex items-start gap-2.5">
              <img src="${item.image || '/logo-mark.svg'}" alt="${item.name}" class="w-12 h-12 rounded-md object-cover border border-surface-container-high" loading="lazy" />
              <div>
              <p class="font-semibold text-on-surface leading-tight">${item.name}</p>
              <p class="text-xs text-on-surface-variant">SKU: ${item.sku || 'N/A'}</p>
              ${item.variantLabel ? `<p class="text-xs text-secondary font-semibold">${item.variantLabel}</p>` : ''}
              </div>
            </div>
            <button class="cart-remove text-error" data-product-id="${item.key}">
              <span class="material-symbols-outlined text-lg">delete</span>
            </button>
          </div>
          <div class="flex items-center justify-between">
            <p class="font-bold text-primary">${formatPrice(item.price || 0)}</p>
            <div class="flex items-center gap-2">
              <button class="cart-qty-minus w-7 h-7 rounded-md bg-surface-container text-sm" data-product-id="${item.key}">-</button>
              <span class="min-w-5 text-center font-semibold text-sm">${item.quantity}</span>
              <button class="cart-qty-plus w-7 h-7 rounded-md bg-surface-container text-sm" data-product-id="${item.key}">+</button>
            </div>
          </div>
        </div>
      `).join('');

      updateCartBadge();
    }

    function addToCart(cartKey: string, productId: string, name: string, sku: string, variantLabel: string, price: number, quantity: number, image: string) {
      const existing = cart.get(cartKey);
      if (existing) {
        existing.quantity += quantity;
      } else {
        cart.set(cartKey, { id: productId, key: cartKey, name, sku, variantLabel, price, quantity, image });
      }
      renderCart();
    }

    cartToggleBtn?.addEventListener('click', openCart);
    cartCloseBtn?.addEventListener('click', closeCart);
    cartOverlay?.addEventListener('click', closeCart);
    
    const cartContinueBtn = document.getElementById('cart-continue-shopping') as HTMLButtonElement;
    cartContinueBtn?.addEventListener('click', closeCart);
    
    cartClearBtn?.addEventListener('click', () => {
      cart.clear();
      renderCart();
    });

    cartItemsContainer?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const button = target.closest('button') as HTMLButtonElement | null;
      if (!button) return;

      const productId = button.getAttribute('data-product-id');
      if (!productId || !cart.has(productId)) return;

      const item = cart.get(productId);
      if (!item) return;

      if (button.classList.contains('cart-qty-minus')) {
        item.quantity = Math.max(1, item.quantity - 1);
      }

      if (button.classList.contains('cart-qty-plus')) {
        item.quantity += 1;
      }

      if (button.classList.contains('cart-remove')) {
        cart.delete(productId);
      }

      renderCart();
    });

    cartSendBtn?.addEventListener('click', () => {
      if (cart.size === 0) return;

      const lines = Array.from(cart.values()).map((item) => {
        const variantLine = item.variantLabel ? ` - ${item.variantLabel}` : '';
        return `- ${item.name}${variantLine} (SKU: ${item.sku || 'N/A'}) x${item.quantity}`;
      });

      const message = `Hola, quiero cotizar:\n${lines.join('\n')}`;
      window.open(`https://wa.me/573115412230?text=${encodeURIComponent(message)}`, '_blank');
    });

    // Build products list for autocomplete
    categorySections.forEach(section => {
      const categoryId = section.getAttribute('data-category') || '';
      section.querySelectorAll('.product-card').forEach(card => {
        const name = card.getAttribute('data-product-name') || '';
        const description = card.getAttribute('data-product-description') || '';
        const price = parseInt(card.getAttribute('data-product-price') || '0');
        const imgEl = card.querySelector('.product-main-image') as HTMLImageElement;
        const image = imgEl?.src || '';
        if (name) {
          allProducts.push({ name, description, category: categoryId, image, price });
        }
      });
    });

    // Show autocomplete suggestions
    function showAutocomplete(searchTerm: string) {
      if (!searchTerm || searchTerm.length < 2) {
        autocompleteDropdown.style.opacity = '0';
        autocompleteDropdown.classList.add('pointer-events-none');
        return;
      }

      const matches = allProducts.filter(product => 
        product.name.includes(searchTerm.toLowerCase())
      ).slice(0, 5); // Max 5 suggestions

      if (matches.length === 0) {
        autocompleteDropdown.style.opacity = '0';
        autocompleteDropdown.classList.add('pointer-events-none');
        return;
      }

      autocompleteDropdown.innerHTML = matches.map(product => `
        <div class="autocomplete-item px-3 py-2 cursor-pointer border-b border-surface-container-highest last:border-0" data-product="${product.name}">
          <div class="flex items-center gap-3">
            <img src="${product.image}" alt="${product.name}" class="w-10 h-10 rounded object-cover bg-surface-container" />
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-on-surface text-sm truncate">${product.name.charAt(0).toUpperCase() + product.name.slice(1)}</div>
              <div class="text-xs text-on-surface-variant truncate">${product.description.slice(0, 40)}...</div>
            </div>
            <div class="text-sm font-bold text-primary whitespace-nowrap">
              ${product.price ? `$${(product.price / 1000).toFixed(3).replace('.', ',')}` : 'Consultar'}
            </div>
          </div>
        </div>
      `).join('');

      // Add click handlers to autocomplete items
      autocompleteDropdown.querySelectorAll('.autocomplete-item').forEach(item => {
        item.addEventListener('click', () => {
          const productName = item.getAttribute('data-product') || '';
          searchInput.value = productName.charAt(0).toUpperCase() + productName.slice(1);
          currentSearchTerm = productName;
          autocompleteDropdown.style.opacity = '0';
          autocompleteDropdown.classList.add('pointer-events-none');
          updateCategoryVisibility();
        });
      });

      autocompleteDropdown.style.opacity = '1';
      autocompleteDropdown.classList.remove('pointer-events-none');
    }

    // Update visible products based on search filter only
    function updateCategoryVisibility() {
      categorySections.forEach(section => {
        const sectionElement = section as HTMLElement;
        const productCards = section.querySelectorAll('.product-card');

        let visibleInCategory = 0;

        productCards.forEach(card => {
          const cardElement = card as HTMLElement;
          const productName = card.getAttribute('data-product-name') || '';
          const productDescription = card.getAttribute('data-product-description') || '';

          const searchMatches = !currentSearchTerm ||
                              productName.includes(currentSearchTerm) ||
                              productDescription.includes(currentSearchTerm);

          if (searchMatches) {
            cardElement.style.display = '';
            visibleInCategory++;
          } else {
            cardElement.style.display = 'none';
          }
        });

        // Show/hide section based on search results only
        if (visibleInCategory > 0) {
          sectionElement.style.display = 'block';
        } else {
          sectionElement.style.display = 'none';
        }
      });

      // Update clear search button visibility
      if (currentSearchTerm) {
        clearSearchBtn.style.opacity = '1';
        clearSearchBtn.classList.remove('pointer-events-none');
      } else {
        clearSearchBtn.style.opacity = '0';
        clearSearchBtn.classList.add('pointer-events-none');
      }
      
      // Update visual category cards
      updateCategoryCards();
    }

    // Update visual category card states
    function updateCategoryCards() {
      categoryCards.forEach(card => {
        const cardCategoryId = card.getAttribute('data-category');

        if (currentCategory === cardCategoryId) {
          card.classList.add('active-category');
        } else {
          card.classList.remove('active-category');
        }
      });
    }

    // Search input handler
    searchInput?.addEventListener('input', (e) => {
      currentSearchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
      showAutocomplete(currentSearchTerm);
      updateCategoryVisibility();
    });

    // Hide autocomplete when clicking outside
    document.addEventListener('click', (e) => {
      if (!searchInput?.contains(e.target as Node) && !autocompleteDropdown?.contains(e.target as Node)) {
        autocompleteDropdown.style.opacity = '0';
        autocompleteDropdown.classList.add('pointer-events-none');
      }
    });

    // Category card click handler - scroll to section
    categoryCards.forEach(card => {
      card.addEventListener('click', () => {
        const categoryId = card.getAttribute('data-category') || '';
        
        // Update active state
        if (currentCategory === categoryId) {
          currentCategory = '';
        } else {
          currentCategory = categoryId;
        }
        
        updateCategoryCards();
        
        // Scroll to category section
        if (categoryId) {
          const targetSection = document.getElementById(`category-${categoryId}`);
          if (targetSection) {
            const headerOffset = 20; // Small offset from top
            const elementPosition = targetSection.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
            
            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }
        } else {
          // If "Todas" is clicked, scroll to products section
          const productsSection = document.getElementById('products-section');
          if (productsSection) {
            productsSection.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

    // Clear search button
    clearSearchBtn?.addEventListener('click', () => {
      searchInput.value = '';
      currentSearchTerm = '';
      autocompleteDropdown.style.opacity = '0';
      autocompleteDropdown.classList.add('pointer-events-none');
      updateCategoryVisibility();
      searchInput.focus();
    });

    // PDF Download / Print button
    const downloadPdfBtn = document.getElementById('download-pdf-btn');
    downloadPdfBtn?.addEventListener('click', async () => {
      // 1. Reset filters so the whole catalog is visible before printing
      if (currentSearchTerm !== '' || currentCategory !== '') {
        searchInput.value = '';
        currentSearchTerm = '';
        currentCategory = '';
        updateCategoryVisibility();
      }

      // 2. Preload all images before printing
      const images = document.querySelectorAll('.product-main-image') as NodeListOf<HTMLImageElement>;
      const imagePromises = Array.from(images).map(img => {
        return new Promise<void>((resolve) => {
          if (img.complete) {
            resolve();
          } else {
            img.onload = () => resolve();
            img.onerror = () => resolve();
          }
          // Force load by removing lazy loading
          img.loading = 'eager';
          // Trigger reload if needed
          const src = img.src;
          img.src = '';
          img.src = src;
        });
      });

      // Wait for all images to load (max 5 seconds)
      await Promise.race([
        Promise.all(imagePromises),
        new Promise(resolve => setTimeout(resolve, 5000))
      ]);

      const startPrint = () => {
        document.body.classList.add('pdf-export-mode');
        window.print();
      };

      const handleAfterPrint = () => {
        document.body.classList.remove('pdf-export-mode');
        window.removeEventListener('afterprint', handleAfterPrint);
      };

      window.addEventListener('afterprint', handleAfterPrint);

      // 3. Trigger browser's native print/PDF generator after images load
      setTimeout(startPrint, 300);
    });

    // Initial display: show all categories
    categorySections.forEach(section => {
      (section as HTMLElement).style.display = 'block';
    });

    // WhatsApp button functionality
    document.querySelectorAll('.whatsapp-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const productId = btn.getAttribute('data-product-id');
        const productName = btn.getAttribute('data-product-name');
        const productSku = btn.getAttribute('data-product-sku');
        const productPrice = btn.getAttribute('data-product-price');
        const variantLabel = btn.getAttribute('data-product-variant-label');
        
        const quantity = 1;
        
        // Format price
        const priceFormatted = productPrice ? `$${(parseInt(productPrice) / 1000).toFixed(3).replace('.', ',')} COP` : 'Consultar';
        
        // Build WhatsApp message
        let message = `¡Hola! Me interesa: ${productName}`;

        if (variantLabel) {
          message += ` - ${variantLabel}`;
        }
        
        if (productSku) {
          message += ` (SKU: ${productSku})`;
        }
        
        message += ` - Cantidad: ${quantity} unidad${quantity > 1 ? 'es' : ''}`;
        
        if (productPrice) {
          message += ` - Precio unitario: ${priceFormatted}`;
        }
        
        // Open WhatsApp
        const whatsappUrl = `https://wa.me/573115412230?text=${encodeURIComponent(message)}`;
        window.open(whatsappUrl, '_blank');
      });
    });

    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const productId = btn.getAttribute('data-product-id') || '';
        const productName = btn.getAttribute('data-product-name') || 'Producto';
        const productSku = btn.getAttribute('data-product-sku') || '';
        const productPrice = parseInt(btn.getAttribute('data-product-price') || '0');
        const productImage = btn.getAttribute('data-product-image') || '';
        const variantId = btn.getAttribute('data-product-variant-id') || '';
        const variantLabel = btn.getAttribute('data-product-variant-label') || '';
        const cartKey = variantId ? `${productId}:${variantId}` : productId;

        addToCart(cartKey, productId, productName, productSku, variantLabel, productPrice, 1, productImage);
        openCart();
      });
    });

    const findMatchingVariant = (variants, selection) => {
      if (!Array.isArray(variants) || variants.length === 0) return null;

      const selectedEntries = Object.entries(selection).filter(([, value]) => String(value || '').trim().length > 0);
      if (selectedEntries.length === 0) return variants[0];

      return (
        variants.find((variant) =>
          selectedEntries.every(([name, value]) =>
            Array.isArray(variant.attributes) && variant.attributes.some((attribute) => attribute.name === name && attribute.value === value)
          )
        ) || variants[0]
      );
    };

    // Image carousel and variant functionality
    document.querySelectorAll('.product-card').forEach(card => {
      const imagesData = card.getAttribute('data-product-images');
      const variantsData = card.getAttribute('data-product-variants');
      const defaultSelectionData = card.getAttribute('data-product-default-selection');

      let images: string[] = [];
      let variants = [];
      let selection = {};

      try {
        images = JSON.parse(imagesData);
      } catch {
        images = [];
      }

      try {
        variants = JSON.parse(variantsData || '[]');
      } catch {
        variants = [];
      }

      try {
        selection = JSON.parse(defaultSelectionData || '{}');
      } catch {
        selection = {};
      }
      
      const mainImg = card.querySelector('.product-main-image') as HTMLImageElement;
      const priceEl = card.querySelector('.product-price') as HTMLElement;
      const selectedVariantEl = card.querySelector('.product-selected-variant') as HTMLElement;
      const addToCartBtn = card.querySelector('.add-to-cart-btn') as HTMLButtonElement;
      const whatsappBtn = card.querySelector('.whatsapp-btn') as HTMLButtonElement;
      const whatsappPriceEl = card.querySelector('.product-whatsapp-price') as HTMLElement;
      const dotsContainer = card.querySelector('.product-image-container');
      if (!mainImg || !addToCartBtn || !whatsappBtn || !priceEl || !selectedVariantEl || !whatsappPriceEl) return;

      const basePrice = parseInt(card.getAttribute('data-product-base-price') || '0');
      const baseImage = card.getAttribute('data-product-base-image') || mainImg.src;
      let allImages = images.length > 0 ? images : [baseImage];
      
      let currentIndex = 0;
      const dots = card.querySelectorAll('.product-img-dot');
      const prevBtn = card.querySelector('.product-img-prev');
      const nextBtn = card.querySelector('.product-img-next');
      
      const updateImage = (index: number) => {
        currentIndex = index;
        mainImg.src = allImages[index];
        
        // Update dot indicators
        dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('active');
            dot.classList.remove('bg-on-primary/60');
            dot.classList.add('bg-on-primary');
          } else {
            dot.classList.remove('active');
            dot.classList.remove('bg-on-primary');
            dot.classList.add('bg-on-primary/60');
          }
        });
      };

      const applyVariantState = () => {
        const selectedVariant = findMatchingVariant(variants, selection);
        const activePrice = selectedVariant?.price || basePrice;
        const activeImage = selectedVariant?.image || baseImage;
        const activeLabel = selectedVariant?.label || 'Sin variante seleccionada';

        allImages = [activeImage, ...images.filter((image) => image && image !== activeImage)];
        currentIndex = 0;
        mainImg.src = allImages[0] || baseImage;

        priceEl.textContent = activePrice ? formatPrice(activePrice) : 'Consultar';
        selectedVariantEl.textContent = selectedVariant ? activeLabel : 'Sin variante seleccionada';
        whatsappPriceEl.textContent = activePrice ? formatPrice(activePrice) : 'Consultar';

        addToCartBtn.setAttribute('data-product-price', String(activePrice || 0));
        addToCartBtn.setAttribute('data-product-image', activeImage || '');
        addToCartBtn.setAttribute('data-product-variant-id', selectedVariant?.id || '');
        addToCartBtn.setAttribute('data-product-variant-label', selectedVariant ? activeLabel : '');
        whatsappBtn.setAttribute('data-product-price', String(activePrice || 0));
        whatsappBtn.setAttribute('data-product-variant-id', selectedVariant?.id || '');
        whatsappBtn.setAttribute('data-product-variant-label', selectedVariant ? activeLabel : '');

        dots.forEach((dot, index) => {
          if (index === 0) {
            dot.classList.add('active');
            dot.classList.remove('bg-on-primary/60');
            dot.classList.add('bg-on-primary');
          } else {
            dot.classList.remove('active');
            dot.classList.remove('bg-on-primary');
            dot.classList.add('bg-on-primary/60');
          }
        });
      };

      card.querySelectorAll('.variant-option-btn').forEach((button) => {
        button.addEventListener('click', () => {
          const attributeName = button.getAttribute('data-attribute-name') || '';
          const attributeValue = button.getAttribute('data-attribute-value') || '';
          selection[attributeName] = attributeValue;

          const group = button.closest('[data-variant-group]');
          group?.querySelectorAll('.variant-option-btn').forEach((option) => {
            option.classList.remove('border-secondary', 'bg-secondary/12', 'text-secondary');
            option.classList.add('border-outline-variant', 'bg-surface-container', 'text-on-surface-variant');
            option.setAttribute('aria-pressed', 'false');
          });

          button.classList.remove('border-outline-variant', 'bg-surface-container', 'text-on-surface-variant');
          button.classList.add('border-secondary', 'bg-secondary/12', 'text-secondary');
          button.setAttribute('aria-pressed', 'true');

          applyVariantState();
        });
      });

      applyVariantState();

      // Previous button
      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const newIndex = currentIndex === 0 ? allImages.length - 1 : currentIndex - 1;
        updateImage(newIndex);
      });
      
      // Next button
      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const newIndex = currentIndex === allImages.length - 1 ? 0 : currentIndex + 1;
        updateImage(newIndex);
      });
      
      // Dot indicators
        dots.forEach((dot, index) => {
          dot.addEventListener('click', (e) => {
            e.stopPropagation();
            updateImage(index);
          });
        });
    });

    renderCart();
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Smooth category transitions */
  .category-section {
    animation: sectionReveal 0.55s ease-out;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .catalog-mounted #catalog-hero .max-w-screen-2xl,
  .catalog-mounted #products-section > .max-w-screen-2xl {
    animation: catalogEnter 620ms ease-out both;
  }

  .catalog-mounted #products-section {
    animation: catalogBgEnter 700ms ease-out both;
  }

  @keyframes catalogEnter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes catalogBgEnter {
    from { filter: saturate(0.96); }
    to { filter: saturate(1); }
  }

  @keyframes sectionReveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .category-card.active-category .category-avatar {
    box-shadow: 0 0 0 2px rgba(166, 128, 83, 0.25), 0 0 18px rgba(166, 128, 83, 0.26);
    border-color: rgba(166, 128, 83, 0.5);
    animation: avatarPulse 1.8s ease-in-out infinite;
  }

  .category-card.active-category h3 {
    color: var(--color-tertiary);
  }

  .category-card.active-category {
    border-color: rgba(166, 128, 83, 0.46);
    background: rgba(255, 252, 245, 0.98);
  }

  @keyframes avatarPulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 0 0 2px rgba(166, 128, 83, 0.24), 0 0 8px rgba(166, 128, 83, 0.18);
    }
    50% {
      transform: scale(1.03);
      box-shadow: 0 0 0 2px rgba(166, 128, 83, 0.38), 0 0 14px rgba(166, 128, 83, 0.28);
    }
  }
  
  /* Autocomplete dropdown */
  .autocomplete-dropdown {
    max-height: 300px;
    overflow-y: auto;
  }
  
  .autocomplete-item {
    transition: all 0.2s ease;
  }
  
  .autocomplete-item:hover {
    background: var(--color-primary-container);
  }

  /* Image carousel styles */
  .product-img-dot.active {
    background: white !important;
    transform: scale(1.2);
  }
  
  .product-image-container .product-img-prev,
  .product-image-container .product-img-next {
    transition: opacity 0.3s ease, transform 0.2s ease;
  }
  
  .product-image-container .product-img-prev:hover,
  .product-image-container .product-img-next:hover {
    transform: translateY(-50%) scale(1.1);
  }
  
  .product-main-image {
    transition: transform 0.5s ease, opacity 0.3s ease;
  }

  /* --- PRINT STYLES FOR PDF EXPORT --- */
  @media print {
    @page {
      size: landscape;
      margin: 0.8cm;
    }

    /* Hide everything globally except the main wrapper */
    :global(body > *:not(main)) {
      display: none !important;
    }
    
    /* Explicitly hide nav and footer just in case */
    :global(nav), :global(footer), :global(#whatsapp-button), :global(#whatsapp-floating) {
      display: none !important;
    }
    
    /* We have a padding-top on main that ruins print pages, reset it */
    :global(main) {
      padding-top: 0 !important;
    }

    /* Show PDF cover page - styled */
    #pdf-cover {
      display: flex !important;
      page-break-after: always;
      break-after: page;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    #pdf-cover img {
      height: 320px !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    #pdf-cover h1 {
      font-size: 42px !important;
      color: #8C2D18 !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    #pdf-cover .material-symbols-outlined {
