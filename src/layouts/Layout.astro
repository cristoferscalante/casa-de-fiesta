---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = 'Mister LyA | El Flujo Prístino', 
	description = 'Elevamos el estándar de higiene con fórmulas editoriales diseñadas para el cuidado profesional de tus espacios más preciados.'
} = Astro.props;

const bubbles = [
	{ x: '6%', size: '14px', dur: '20s', delay: '0s', drift: '14px' },
	{ x: '14%', size: '10px', dur: '16s', delay: '3s', drift: '-10px' },
	{ x: '22%', size: '18px', dur: '24s', delay: '8s', drift: '18px' },
	{ x: '31%', size: '12px', dur: '18s', delay: '2s', drift: '-14px' },
	{ x: '39%', size: '20px', dur: '26s', delay: '6s', drift: '16px' },
	{ x: '48%', size: '11px', dur: '17s', delay: '11s', drift: '-12px' },
	{ x: '57%', size: '16px', dur: '22s', delay: '4s', drift: '12px' },
	{ x: '66%', size: '13px', dur: '19s', delay: '9s', drift: '-16px' },
	{ x: '74%', size: '22px', dur: '28s', delay: '1s', drift: '20px' },
	{ x: '82%', size: '12px', dur: '21s', delay: '7s', drift: '-10px' },
	{ x: '90%', size: '15px', dur: '23s', delay: '5s', drift: '14px' },
	{ x: '95%', size: '9px', dur: '15s', delay: '10s', drift: '-8px' },
];
---

<!DOCTYPE html>
<html class="light" lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		
		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
		
		<title>{title}</title>
	</head>
	<body class="text-on-surface overflow-x-hidden relative">
		<div class="soap-bubbles" aria-hidden="true">
			{bubbles.map((bubble) => (
				<span
					class="soap-bubble"
					style={`--x:${bubble.x}; --size:${bubble.size}; --dur:${bubble.dur}; --delay:${bubble.delay}; --drift:${bubble.drift};`}
				></span>
			))}
		</div>
		<slot />
	</body>
	<style>
		.soap-bubbles {
			position: fixed;
			inset: 0;
			pointer-events: none;
			overflow: hidden;
			z-index: 1;
		}

		.soap-bubble {
			position: absolute;
			left: var(--x);
			bottom: -48px;
			width: var(--size);
			height: var(--size);
			border-radius: 999px;
			background:
				radial-gradient(circle at 28% 24%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.08) 46%),
				radial-gradient(circle at 72% 76%, rgba(116, 175, 255, 0.3), rgba(160, 214, 255, 0.02) 54%);
			border: 1px solid rgba(16, 86, 165, 0.24);
			box-shadow:
				inset 0 0 12px rgba(255, 255, 255, 0.4),
				0 0 10px rgba(84, 145, 227, 0.18),
				0 0 0 1px rgba(170, 212, 255, 0.18);
			opacity: 0;
			animation: floatBubble var(--dur) linear var(--delay) infinite;
			will-change: transform, opacity;
		}

		@keyframes floatBubble {
			0% {
				transform: translate3d(0, 0, 0) scale(0.94);
				opacity: 0;
			}
			8% {
				opacity: 0.4;
			}
			50% {
				transform: translate3d(var(--drift), -52vh, 0) scale(1);
				opacity: 0.32;
			}
			100% {
				transform: translate3d(calc(var(--drift) * -1), -108vh, 0) scale(1.08);
				opacity: 0;
			}
		}

		@media (max-width: 768px) {
			.soap-bubbles .soap-bubble:nth-child(n + 9) {
				display: none;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.soap-bubbles {
				display: none;
			}
		}
	</style>
</html>
