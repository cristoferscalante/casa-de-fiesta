# ============================================
# VARIABLES DE ENTORNO - MISTER LYA
# ============================================

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# Para desarrollo local: usar SQLite
DATABASE_URL=file:./local.db

# Para producción: usar Turso (SQLite distribuido)
# Crear cuenta gratuita en: https://turso.tech
# DATABASE_URL=libsql://[your-database].turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# --------------------------------------------
# Authentication (Auth.js)
# --------------------------------------------
# Generar un secret seguro con:
# openssl rand -base64 32
AUTH_SECRET=your-secret-here-CHANGE-IN-PRODUCTION
AUTH_TRUST_HOST=true

# Para producción, debe ser un valor diferente y secreto
# Ejemplo: openssl rand -base64 32 | pbcopy

# --------------------------------------------
# Cloudinary Configuration
# --------------------------------------------
# Crear cuenta gratuita en: https://cloudinary.com
# Ir a Dashboard > Account Details
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# INSTRUCCIONES PARA VERCEL
# ============================================
# 1. En Vercel Dashboard > Project Settings > Environment Variables
# 2. Agregar cada variable con su valor
# 3. Importante: NO subir el archivo .env al repositorio
# 4. Variables requeridas para producción:
#    - DATABASE_URL (usar Turso en producción)
#    - DATABASE_AUTH_TOKEN (token de Turso)
#    - AUTH_SECRET (generar uno nuevo)
#    - AUTH_TRUST_HOST=true (necesario para Vercel)
#    - CLOUDINARY_CLOUD_NAME
#    - CLOUDINARY_API_KEY
#    - CLOUDINARY_API_SECRET

# ============================================
# NOTAS
# ============================================
# - El archivo .env está en .gitignore (no se sube a GitHub)
# - Para desarrollo local, copiar este archivo a .env
# - Para producción, configurar en Vercel Dashboard
